import Mathlib.Logic.Relation
import Mathlib.Tactic
import MixedSignCoxeter.Basic

/-!
# Finite Mixed-Sign Reduction & General Corollary 3.18

Formalization of the finiteness reduction from `docs/verifications.md` (§3, Remark A.3)
and the general rank-arbitrary form of **Corollary 3.18** from:
Johnathon Kyle Armstrong, *Principal Elements of Mixed-Sign Coxeter Systems* (FSU, 2012).

## Main results
* `W_group S`: The reflection group `W(S)` generated by `reflectionMatrix S.B i`.
* `finite_connected_isDefinite`: If `S : ReflectionSystem n` (`0 < n`) is connected and
  `W_group S` is finite, then `S` is definite (`S.IsPosDef ∨ S.IsNegDef`), proved by
  averaging the standard inner product over `W_group S` to obtain a `W`-invariant
  positive-definite form `G` and showing `G = c₀ • S.B` via connectedness.
* `corollary_3_18_mixed_sign_infinite`: Every connected `ReflectionSystem` having both a
  positive node (`S.B i i > 0`) and a negative node (`S.B j j < 0`) generates an infinite
  group (`¬ Finite (W_group S)`).
-/

open Matrix BigOperators

namespace ReflectionSystem

section FiniteReduction

variable {n : ℕ}

/-- The reflection group `W(S)` as the matrix submonoid generated by the reflections
`reflectionMatrix S.B i`. -/
noncomputable def W_group (S : ReflectionSystem n) : Submonoid (Matrix (Fin n) (Fin n) ℝ) :=
  Submonoid.closure (Set.range (reflectionMatrix S.B))

/-- A `ReflectionSystem` is connected if every pair of vertices is linked by a chain of
nonzero entries of `S.B`. -/
def IsConnected (S : ReflectionSystem n) : Prop :=
  ∀ i j : Fin n, Relation.ReflTransGen (fun u v => S.B u v ≠ 0) i j

private noncomputable def avgForm (S : ReflectionSystem n) [Fintype (W_group S)] :
    Matrix (Fin n) (Fin n) ℝ :=
  ∑ w : W_group S, w.1ᵀ * w.1

private lemma avgForm_symm (S : ReflectionSystem n) [Fintype (W_group S)] :
    (avgForm S).IsSymm := by
  unfold Matrix.IsSymm avgForm
  rw [transpose_sum]
  refine Finset.sum_congr rfl fun w _ => ?_
  rw [Matrix.transpose_mul, Matrix.transpose_transpose]

private lemma avgForm_invariant (S : ReflectionSystem n) [Fintype (W_group S)] (i : Fin n) :
    (reflectionMatrix S.B i)ᵀ * avgForm S * reflectionMatrix S.B i = avgForm S := by
  let si : W_group S := ⟨reflectionMatrix S.B i, Submonoid.subset_closure ⟨i, rfl⟩⟩
  let e : W_group S ≃ W_group S :=
    { toFun := fun w => w * si
      invFun := fun w => w * si
      left_inv := fun w => by
        ext1
        show (w.1 * reflectionMatrix S.B i) * reflectionMatrix S.B i = w.1
        rw [mul_assoc, reflectionMatrix_mul_self S i, mul_one]
      right_inv := fun w => by
        ext1
        show (w.1 * reflectionMatrix S.B i) * reflectionMatrix S.B i = w.1
        rw [mul_assoc, reflectionMatrix_mul_self S i, mul_one] }
  unfold avgForm
  rw [Finset.mul_sum, Finset.sum_mul]
  calc ∑ w : W_group S, (reflectionMatrix S.B i)ᵀ * (w.1ᵀ * w.1) * reflectionMatrix S.B i
      = ∑ w : W_group S, (w * si).1ᵀ * (w * si).1 := by
          refine Finset.sum_congr rfl fun w _ => ?_
          show (reflectionMatrix S.B i)ᵀ * (w.1ᵀ * w.1) * reflectionMatrix S.B i =
            (w.1 * reflectionMatrix S.B i)ᵀ * (w.1 * reflectionMatrix S.B i)
          rw [Matrix.transpose_mul]
          simp only [mul_assoc]
    _ = ∑ w : W_group S, w.1ᵀ * w.1 :=
          Equiv.sum_comp e (fun w : W_group S => w.1ᵀ * w.1)

private lemma quadForm_avgForm_pos (S : ReflectionSystem n) [Fintype (W_group S)]
    {v : Fin n → ℝ} (hv : v ≠ 0) :
    0 < quadForm (avgForm S) v := by
  have hterm : ∀ w : W_group S,
      ∑ i : Fin n, ∑ j : Fin n, v i * (w.1ᵀ * w.1) i j * v j =
        ∑ r : Fin n, (∑ i : Fin n, w.1 r i * v i) ^ 2 := by
    intro w
    simp only [Matrix.mul_apply, Matrix.transpose_apply]
    calc ∑ i : Fin n, ∑ j : Fin n, v i * (∑ r : Fin n, w.1 r i * w.1 r j) * v j
        = ∑ i : Fin n, ∑ j : Fin n, ∑ r : Fin n, (w.1 r i * v i) * (w.1 r j * v j) := by
            refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
            rw [Finset.mul_sum, Finset.sum_mul]
            refine Finset.sum_congr rfl fun r _ => by ring
      _ = ∑ r : Fin n, ∑ i : Fin n, ∑ j : Fin n, (w.1 r i * v i) * (w.1 r j * v j) := by
            have hsw : (∑ i : Fin n, ∑ j : Fin n, ∑ r : Fin n, (w.1 r i * v i) * (w.1 r j * v j)) =
                ∑ i : Fin n, ∑ r : Fin n, ∑ j : Fin n, (w.1 r i * v i) * (w.1 r j * v j) :=
              Finset.sum_congr rfl fun _ _ => Finset.sum_comm
            rw [hsw, Finset.sum_comm]
      _ = ∑ r : Fin n, (∑ i : Fin n, w.1 r i * v i) ^ 2 := by
            refine Finset.sum_congr rfl fun r _ => ?_
            rw [sq, Finset.sum_mul]
            refine Finset.sum_congr rfl fun i _ => (Finset.mul_sum _ _ _).symm
  have hquad : quadForm (avgForm S) v =
      ∑ w : W_group S, ∑ r : Fin n, (∑ i : Fin n, w.1 r i * v i) ^ 2 := by
    unfold quadForm avgForm
    simp only [Matrix.sum_apply]
    have h1 : (∑ i : Fin n, ∑ j : Fin n,
          v i * (∑ w : W_group S, (w.1ᵀ * w.1) i j) * v j) =
        ∑ i : Fin n, ∑ w : W_group S, ∑ j : Fin n, v i * (w.1ᵀ * w.1) i j * v j := by
      refine Finset.sum_congr rfl fun i _ => ?_
      calc ∑ j : Fin n, v i * (∑ w : W_group S, (w.1ᵀ * w.1) i j) * v j
          = ∑ j : Fin n, ∑ w : W_group S, v i * (w.1ᵀ * w.1) i j * v j := by
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [Finset.mul_sum, Finset.sum_mul]
        _ = ∑ w : W_group S, ∑ j : Fin n, v i * (w.1ᵀ * w.1) i j * v j := Finset.sum_comm
    rw [h1, Finset.sum_comm]
    exact Finset.sum_congr rfl fun w _ => hterm w
  rw [hquad]
  obtain ⟨r₀, hr₀⟩ := Function.ne_iff.mp hv
  have h1_term : 0 < ∑ r : Fin n, (∑ i : Fin n, (1 : W_group S).1 r i * v i) ^ 2 := by
    have hsimp : ∑ r : Fin n, (∑ i : Fin n, (1 : W_group S).1 r i * v i) ^ 2 =
        ∑ r : Fin n, v r ^ 2 := by
      refine Finset.sum_congr rfl fun r _ => ?_
      have hrow : ∑ i : Fin n, (1 : Matrix (Fin n) (Fin n) ℝ) r i * v i = v r := by
        simp [Matrix.one_apply]
      show (∑ i : Fin n, (1 : Matrix (Fin n) (Fin n) ℝ) r i * v i) ^ 2 = v r ^ 2
      rw [hrow]
    rw [hsimp]
    have hpos : 0 < v r₀ ^ 2 := sq_pos_of_ne_zero hr₀
    have hle : v r₀ ^ 2 ≤ ∑ r : Fin n, v r ^ 2 :=
      Finset.single_le_sum (fun r _ => sq_nonneg (v r)) (Finset.mem_univ r₀)
    linarith
  have hle_sum :
      (∑ r : Fin n, (∑ i : Fin n, (1 : W_group S).1 r i * v i) ^ 2) ≤
        ∑ w : W_group S, ∑ r : Fin n, (∑ i : Fin n, w.1 r i * v i) ^ 2 :=
    Finset.single_le_sum
      (f := fun w : W_group S => ∑ r : Fin n, (∑ i : Fin n, w.1 r i * v i) ^ 2)
      (fun w _ => Finset.sum_nonneg fun r _ => sq_nonneg _)
      (Finset.mem_univ (1 : W_group S))
  linarith

private lemma avgForm_diag_pos (S : ReflectionSystem n) [Fintype (W_group S)] (i : Fin n) :
    0 < avgForm S i i := by
  let e : Fin n → ℝ := fun r => if r = i then 1 else 0
  have he : e ≠ 0 := by
    intro h
    have := congrFun h i
    simp [e] at this
  have hpos := quadForm_avgForm_pos S he
  have hquad : quadForm (avgForm S) e = avgForm S i i := by
    unfold quadForm
    simp [e]
  linarith

private lemma avgForm_entry_ratio (S : ReflectionSystem n) [Fintype (W_group S)] (i j : Fin n) :
    avgForm S i j = (avgForm S i i / S.B i i) * S.B i j := by
  have hinv := congrFun (congrFun (avgForm_invariant S i) i) j
  have hBii : S.B i i ≠ 0 := S.B_diag_ne_zero i
  have hcol_i : ∀ r : Fin n, reflectionMatrix S.B i r i = if r = i then -1 else 0 := by
    intro r
    rw [reflectionMatrix_apply]
    by_cases hri : r = i
    · subst hri; simp [hBii]; ring
    · simp [hri]
  simp only [Matrix.mul_apply, Matrix.transpose_apply] at hinv
  have hleft :
      (∑ x : Fin n,
        (∑ r : Fin n, reflectionMatrix S.B i r i * avgForm S r x) *
          reflectionMatrix S.B i x j) =
      -(avgForm S i j) + (2 * S.B i j / S.B i i) * avgForm S i i := by
    have h1 : ∀ x : Fin n,
        (∑ r : Fin n, reflectionMatrix S.B i r i * avgForm S r x) = -avgForm S i x := by
      intro x
      simp_rw [hcol_i]
      simp
    simp_rw [h1, reflectionMatrix_apply]
    calc ∑ x : Fin n, -avgForm S i x *
          ((if x = j then 1 else 0) - if x = i then 2 * S.B i j / S.B i i else 0)
        = (∑ x : Fin n, (if x = j then -avgForm S i x else 0)) -
            ∑ x : Fin n, (if x = i then -avgForm S i x * (2 * S.B i j / S.B i i) else 0) := by
            rw [← Finset.sum_sub_distrib]
            refine Finset.sum_congr rfl fun x _ => ?_
            split_ifs <;> ring
      _ = -(avgForm S i j) + (2 * S.B i j / S.B i i) * avgForm S i i := by
            simp [Finset.sum_ite_eq', Finset.mem_univ]; ring
  rw [hleft] at hinv
  have h2 : 2 * avgForm S i j = 2 * ((S.B i j / S.B i i) * avgForm S i i) := by
    have h2' : 2 * avgForm S i j = (2 * S.B i j / S.B i i) * avgForm S i i := by linarith
    rw [h2']; ring
  have h3 : avgForm S i j = (S.B i j / S.B i i) * avgForm S i i := by linarith
  rw [h3]
  field_simp

/-- **Finite Mixed-Sign Reduction (Remark A.3 / `docs/verifications.md` §3)**:
If a connected `ReflectionSystem S` on `n > 0` vertices generates a finite group `W_group S`,
then its bilinear form `S.B` is definite (`S.IsPosDef ∨ S.IsNegDef`). -/
theorem finite_connected_isDefinite (S : ReflectionSystem n) (hn : 0 < n)
    (hconn : S.IsConnected) (hfin : Finite (W_group S)) :
    S.IsPosDef ∨ S.IsNegDef := by
  classical
  let _ : Fintype (W_group S) := Fintype.ofFinite (W_group S)
  let c : Fin n → ℝ := fun i => avgForm S i i / S.B i i
  have hadj : ∀ u v : Fin n, S.B u v ≠ 0 → c u = c v := by
    intro u v huv
    have h1 := avgForm_entry_ratio S u v
    have h2 := avgForm_entry_ratio S v u
    have hG : avgForm S u v = avgForm S v u := by
      have hs := congrFun (congrFun (avgForm_symm S) v) u
      simpa using hs
    have hB : S.B u v = S.B v u := by
      have hs := congrFun (congrFun S.B_symm v) u
      simpa using hs
    have hmul : c u * S.B u v = c v * S.B u v := by
      calc c u * S.B u v = avgForm S u v := h1.symm
        _ = avgForm S v u := hG
        _ = c v * S.B v u := h2
        _ = c v * S.B u v := by rw [hB]
    exact mul_right_cancel₀ huv hmul
  have hconst : ∀ i j : Fin n, c i = c j := by
    intro i j
    induction hconn i j with
    | refl => rfl
    | tail _ hbc ih => exact ih.trans (hadj _ _ hbc)
  let i₀ : Fin n := ⟨0, hn⟩
  have hG_eq : ∀ i j : Fin n, avgForm S i j = c i₀ * S.B i j := by
    intro i j
    rw [avgForm_entry_ratio S i j]
    change c i * S.B i j = c i₀ * S.B i j
    rw [hconst i i₀]
  have hquad_eq : ∀ v : Fin n → ℝ, quadForm (avgForm S) v = c i₀ * quadForm S.B v := by
    intro v
    unfold quadForm
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [hG_eq i j]
    ring
  have hc0 : c i₀ ≠ 0 := div_ne_zero (ne_of_gt (avgForm_diag_pos S i₀)) (S.B_diag_ne_zero i₀)
  rcases lt_or_gt_of_ne hc0 with hneg | hpos
  · right
    intro v hv
    have hGpos := quadForm_avgForm_pos S hv
    rw [hquad_eq v] at hGpos
    nlinarith
  · left
    intro v hv
    have hGpos := quadForm_avgForm_pos S hv
    rw [hquad_eq v] at hGpos
    nlinarith

/-- **General Corollary 3.18**: If a connected `ReflectionSystem` has both a positive node
(`S.B i i > 0`) and a negative node (`S.B j j < 0`), then `S.B` is neither positive definite
nor negative definite, so `W_group S` is infinite (`¬ Finite (W_group S)`). -/
theorem corollary_3_18_mixed_sign_infinite (S : ReflectionSystem n)
    (hconn : S.IsConnected) (i j : Fin n) (hi : 0 < S.B i i) (hj : S.B j j < 0) :
    ¬ Finite (W_group S) := by
  intro hfin
  have hn : 0 < n := Nat.pos_of_ne_zero (fun h0 => by subst h0; exact Fin.elim0 i)
  rcases finite_connected_isDefinite S hn hconn hfin with hpos | hneg
  · let ej : Fin n → ℝ := fun r => if r = j then 1 else 0
    have hej : ej ≠ 0 := by intro h; have := congrFun h j; simp [ej] at this
    have hq := hpos ej hej
    have hval : quadForm S.B ej = S.B j j := by unfold quadForm; simp [ej]
    linarith
  · let ei : Fin n → ℝ := fun r => if r = i then 1 else 0
    have hei : ei ≠ 0 := by intro h; have := congrFun h i; simp [ei] at this
    have hq := hneg ei hei
    have hval : quadForm S.B ei = S.B i i := by unfold quadForm; simp [ei]
    linarith

end FiniteReduction

end ReflectionSystem
