import Mathlib.Combinatorics.SimpleGraph.Acyclic
import Mathlib.Logic.Relation
import MixedSignCoxeter.Bipartite

/-!
# All principal elements of a tree are conjugate (Theorem 2.58, full statement)

Formalization of Theorem 2.58 of:
Johnathon Kyle Armstrong, *Principal Elements of Mixed-Sign Coxeter Systems* (FSU, 2012).

`ComponentsAndTrees.leaf_insert_conj` proves the single leaf-insertion step used in the
dissertation's proof. This file proves the theorem itself: if the reflection diagram `Γ(B)`
is a forest (in particular, a tree), then any two principal elements
`s_{σ(1)} ⋯ s_{σ(n)}` and `s_{τ(1)} ⋯ s_{τ(n)}` are conjugate *inside* `W(Γ)`.

The dissertation's induction ("conjugate the `n`-node principal elements, then insert the
leaf") needs care: the conjugator obtained for the smaller tree need not commute with the
new leaf reflection. We therefore prove a stronger, purely combinatorial statement: any two
orderings of the nodes are related by a chain of

* swaps of adjacent letters `x y ↦ y x` with `B(e_x, e_y) = 0` (Proposition 2.28), and
* cyclic rotations `x r ↦ r x` (conjugation by `s_x`),

and this statement does lift along leaf insertion.

## Main definitions
* `ReflectionSystem.diagram S`: the reflection diagram `Γ(B)` as a `SimpleGraph (Fin n)`,
  with `i ~ j ↔ i ≠ j ∧ B i j ≠ 0` (Definition 2.24).
* `ReflectionSystem.IsPrincipalWord w`: `w` lists every node exactly once (Definition 2.53).
* `ReflectionSystem.ConjInW S a b`: `a` and `b` are conjugate by an element of `W`.

## Main results
* `exists_leaf_of_isAcyclic`: every nonempty set of nodes of a forest contains a node with at
  most one neighbour in that set.
* `principal_moves_of_isAcyclic`: in a forest, any two principal words are related by
  commutation swaps and cyclic rotations.
* `theorem_2_58_principal_conj_of_isAcyclic` / `theorem_2_58_principal_conj_of_isTree`
  (**Theorem 2.58**): in a forest (resp. tree) all principal elements lie in one conjugacy
  class of `W(Γ)`.
-/

open Matrix

namespace ReflectionSystem

variable {n : ℕ}

/-! ### The reflection diagram as a simple graph -/

/-- The reflection diagram `Γ(B)` (Definition 2.24): nodes `Fin n`, with an edge between
`i ≠ j` exactly when `B(e_i, e_j) ≠ 0`. -/
def diagram (S : ReflectionSystem n) : SimpleGraph (Fin n) where
  Adj i j := i ≠ j ∧ S.B i j ≠ 0
  symm := ⟨fun i j h => ⟨h.1.symm, by rw [S.B_symm.apply i j]; exact h.2⟩⟩
  loopless := ⟨fun i h => h.1 rfl⟩

@[simp]
lemma diagram_adj (S : ReflectionSystem n) (i j : Fin n) :
    S.diagram.Adj i j ↔ i ≠ j ∧ S.B i j ≠ 0 := Iff.rfl

/-- A *principal word* lists every node exactly once (Definition 2.53). -/
def IsPrincipalWord (w : List (Fin n)) : Prop :=
  w.Nodup ∧ ∀ i : Fin n, i ∈ w

/-- `a` and `b` are conjugate by an element of the reflection group `W` generated by the
`s_i` (the conjugator is `wordProd S c`, which is invertible with inverse
`wordProd S c.reverse`). -/
def ConjInW (S : ReflectionSystem n) (a b : Matrix (Fin n) (Fin n) ℝ) : Prop :=
  ∃ c : List (Fin n), wordProd S c * a = b * wordProd S c

lemma wordProd_append (S : ReflectionSystem n) (u v : List (Fin n)) :
    wordProd S (u ++ v) = wordProd S u * wordProd S v := by
  simp [wordProd]

lemma wordProd_reverse_mul (S : ReflectionSystem n) (w : List (Fin n)) :
    wordProd S w.reverse * wordProd S w = 1 := by
  simpa using wordProd_mul_reverse S w.reverse

lemma ConjInW.refl (S : ReflectionSystem n) (a : Matrix (Fin n) (Fin n) ℝ) : S.ConjInW a a :=
  ⟨[], by simp [wordProd]⟩

lemma ConjInW.symm {S : ReflectionSystem n} {a b : Matrix (Fin n) (Fin n) ℝ}
    (h : S.ConjInW a b) : S.ConjInW b a := by
  obtain ⟨c, hc⟩ := h
  refine ⟨c.reverse, ?_⟩
  have h1 := wordProd_mul_reverse S c
  have h2 := wordProd_reverse_mul S c
  calc wordProd S c.reverse * b
      = wordProd S c.reverse * b * (wordProd S c * wordProd S c.reverse) := by
        rw [h1, Matrix.mul_one]
    _ = wordProd S c.reverse * (b * wordProd S c) * wordProd S c.reverse := by
        simp only [Matrix.mul_assoc]
    _ = wordProd S c.reverse * (wordProd S c * a) * wordProd S c.reverse := by rw [hc]
    _ = (wordProd S c.reverse * wordProd S c) * a * wordProd S c.reverse := by
        simp only [Matrix.mul_assoc]
    _ = a * wordProd S c.reverse := by rw [h2, Matrix.one_mul]

lemma ConjInW.trans {S : ReflectionSystem n} {a b c : Matrix (Fin n) (Fin n) ℝ}
    (h₁ : S.ConjInW a b) (h₂ : S.ConjInW b c) : S.ConjInW a c := by
  obtain ⟨x, hx⟩ := h₁
  obtain ⟨y, hy⟩ := h₂
  refine ⟨y ++ x, ?_⟩
  rw [wordProd_append]
  calc wordProd S y * wordProd S x * a = wordProd S y * (wordProd S x * a) := by
        rw [Matrix.mul_assoc]
    _ = wordProd S y * (b * wordProd S x) := by rw [hx]
    _ = (wordProd S y * b) * wordProd S x := by rw [Matrix.mul_assoc]
    _ = c * wordProd S y * wordProd S x := by rw [hy]
    _ = c * (wordProd S y * wordProd S x) := by rw [Matrix.mul_assoc]

/-! ### Elementary moves on words -/

/-- One elementary move on words: swap two adjacent commuting letters
(`B(e_x, e_y) = 0`, Proposition 2.28) or rotate the first letter to the end. -/
inductive MoveStep (S : ReflectionSystem n) : List (Fin n) → List (Fin n) → Prop
  | swap (p q : List (Fin n)) (x y : Fin n) (h : S.B x y = 0) :
      MoveStep S (p ++ x :: y :: q) (p ++ y :: x :: q)
  | rotate (x : Fin n) (r : List (Fin n)) : MoveStep S (x :: r) (r ++ [x])

/-- The equivalence relation generated by `MoveStep`. -/
def Moves (S : ReflectionSystem n) : List (Fin n) → List (Fin n) → Prop :=
  Relation.EqvGen (MoveStep S)

lemma Moves.single {S : ReflectionSystem n} {a b : List (Fin n)} (h : MoveStep S a b) :
    S.Moves a b := Relation.EqvGen.rel _ _ h

lemma Moves.refl' (S : ReflectionSystem n) (a : List (Fin n)) : S.Moves a a :=
  Relation.EqvGen.refl a

lemma Moves.symm' {S : ReflectionSystem n} {a b : List (Fin n)} (h : S.Moves a b) :
    S.Moves b a := Relation.EqvGen.symm _ _ h

lemma Moves.trans' {S : ReflectionSystem n} {a b c : List (Fin n)} (h₁ : S.Moves a b)
    (h₂ : S.Moves b c) : S.Moves a c := Relation.EqvGen.trans _ _ _ h₁ h₂

lemma MoveStep.perm {S : ReflectionSystem n} {a b : List (Fin n)} (h : MoveStep S a b) :
    a.Perm b := by
  cases h with
  | swap p q x y _ => exact List.Perm.append_left p (List.Perm.swap y x q)
  | rotate x r => exact (List.perm_append_singleton x r).symm

lemma Moves.perm {S : ReflectionSystem n} {a b : List (Fin n)} (h : S.Moves a b) :
    a.Perm b := by
  induction h with
  | rel _ _ h => exact h.perm
  | refl => exact List.Perm.refl _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Each elementary move replaces a word by a `W`-conjugate word. -/
lemma MoveStep.conjInW {S : ReflectionSystem n} {a b : List (Fin n)} (h : MoveStep S a b) :
    S.ConjInW (wordProd S a) (wordProd S b) := by
  cases h with
  | swap p q x y hxy =>
    have hc := reflectionMatrix_comm_of_orthogonal S hxy
    have : wordProd S (p ++ x :: y :: q) = wordProd S (p ++ y :: x :: q) := by
      simp only [wordProd, List.map_append, List.map_cons, List.prod_append, List.prod_cons]
      rw [← Matrix.mul_assoc (reflectionMatrix S.B x), hc, Matrix.mul_assoc]
    rw [this]
    exact ConjInW.refl S _
  | rotate x r =>
    refine ⟨[x], ?_⟩
    simp only [wordProd, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
      Matrix.mul_one, List.map_append, List.prod_append]
    rw [← Matrix.mul_assoc, reflectionMatrix_mul_self, Matrix.one_mul, Matrix.mul_assoc,
      reflectionMatrix_mul_self, Matrix.mul_one]

lemma Moves.conjInW {S : ReflectionSystem n} {a b : List (Fin n)} (h : S.Moves a b) :
    S.ConjInW (wordProd S a) (wordProd S b) := by
  induction h with
  | rel _ _ h => exact h.conjInW
  | refl => exact ConjInW.refl S _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- A letter `t` orthogonal to every letter of `u` can be commuted to the front past `u`. -/
lemma moves_commute_front (S : ReflectionSystem n) (t : Fin n) (v : List (Fin n)) :
    ∀ (u p : List (Fin n)), (∀ x ∈ u, S.B t x = 0) →
      S.Moves (p ++ u ++ t :: v) (p ++ t :: (u ++ v))
  | [], p, _ => by simpa using Moves.refl' S (p ++ t :: v)
  | x :: u, p, hu => by
    have ih := moves_commute_front S t v u (p ++ [x]) (fun y hy => hu y (by simp [hy]))
    have hxt : S.B x t = 0 := by
      rw [S.B_symm.apply t x]; exact hu x (by simp)
    refine Moves.trans' (b := p ++ [x] ++ t :: (u ++ v)) ?_ ?_
    · simpa using ih
    · have := Moves.single (MoveStep.swap (S := S) p (u ++ v) x t hxt)
      simpa using this

/-- A letter `t` orthogonal to every letter of `v` can be commuted to the end past `v`. -/
lemma moves_commute_back (S : ReflectionSystem n) (t : Fin n) :
    ∀ (v u : List (Fin n)), (∀ x ∈ v, S.B t x = 0) →
      S.Moves (u ++ t :: v) (u ++ v ++ [t])
  | [], u, _ => by simpa using Moves.refl' S (u ++ [t])
  | x :: v, u, hv => by
    have ih := moves_commute_back S t v (u ++ [x]) (fun y hy => hv y (by simp [hy]))
    refine Moves.trans' (b := u ++ [x] ++ t :: v) ?_ ?_
    · have := Moves.single (MoveStep.swap (S := S) u v t x (hv x (by simp)))
      simpa using this
    · simpa using ih

/-- **Leaf normal form**: if `t` is a leaf of the letters of `l` (its only possible
neighbour is `i`), then `l` can be moved to `(l with t removed) ++ [t]`. -/
lemma moves_leaf_to_end (S : ReflectionSystem n) (t i : Fin n) (l : List (Fin n))
    (hnd : l.Nodup) (ht : t ∈ l) (hleaf : ∀ x ∈ l, x ≠ t → x ≠ i → S.B t x = 0) :
    ∃ u v : List (Fin n), l = u ++ t :: v ∧ S.Moves l (u ++ v ++ [t]) := by
  obtain ⟨u, v, rfl⟩ := List.append_of_mem ht
  refine ⟨u, v, rfl, ?_⟩
  have hnd' := hnd
  rw [List.nodup_append] at hnd'
  obtain ⟨hndu, hndtv, hdisj⟩ := hnd'
  have htv : t ∉ v := (List.nodup_cons.mp hndtv).1
  have htu : t ∉ u := fun h => hdisj t h t (by simp) rfl
  by_cases hiv : i ∈ v
  · -- `i ∉ u`: commute `t` to the front, then rotate it to the end.
    have hiu : i ∉ u := fun h => hdisj i h i (by simp [hiv]) rfl
    have hu : ∀ x ∈ u, S.B t x = 0 := fun x hx =>
      hleaf x (by simp [hx]) (fun h => htu (h ▸ hx)) (fun h => hiu (h ▸ hx))
    have h1 := moves_commute_front S t v u [] hu
    have h2 := Moves.single (MoveStep.rotate (S := S) t (u ++ v))
    simp only [List.nil_append] at h1
    exact h1.trans' h2
  · have hv : ∀ x ∈ v, S.B t x = 0 := fun x hx =>
      hleaf x (by simp [hx]) (fun h => htv (h ▸ hx)) (fun h => hiv (h ▸ hx))
    exact moves_commute_back S t v u hv

/-- The invariant carried along a chain of moves when lifting it past a leaf `t`. -/
private def LeafInv (S : ReflectionSystem n) (t i : Fin n) (a : List (Fin n)) : Prop :=
  a.Nodup ∧ t ∉ a ∧ ∀ x ∈ a, x ≠ i → S.B t x = 0

private lemma LeafInv.of_perm {S : ReflectionSystem n} {t i : Fin n} {a b : List (Fin n)}
    (hp : a.Perm b) (h : LeafInv S t i a) : LeafInv S t i b :=
  ⟨hp.nodup_iff.mp h.1, fun hb => h.2.1 (hp.mem_iff.mpr hb),
    fun x hx hxi => h.2.2 x (hp.mem_iff.mpr hx) hxi⟩

private lemma moveStep_lift {S : ReflectionSystem n} {t i : Fin n} {a b : List (Fin n)}
    (h : MoveStep S a b) (hinv : LeafInv S t i a) : S.Moves (a ++ [t]) (b ++ [t]) := by
  cases h with
  | swap p q x y hxy =>
    have := Moves.single (MoveStep.swap (S := S) p (q ++ [t]) x y hxy)
    simpa using this
  | rotate x r =>
    obtain ⟨hnd, htn, hB⟩ := hinv
    have hrot := Moves.single (MoveStep.rotate (S := S) x (r ++ [t]))
    by_cases hxi : x = i
    · subst hxi
      have hxr : x ∉ r := (List.nodup_cons.mp hnd).1
      have hr : ∀ y ∈ r, S.B t y = 0 := fun y hy =>
        hB y (by simp [hy]) (fun h => hxr (h ▸ hy))
      have h1 := moves_commute_front S t [x] r [] hr
      have h2 := Moves.single (MoveStep.rotate (S := S) t (r ++ [x]))
      simp only [List.nil_append] at h1
      refine (Moves.trans' (b := r ++ [t] ++ [x]) ?_ ?_)
      · simpa using hrot
      · have h12 := h1.trans' h2
        simpa using h12
    · have htx : S.B t x = 0 := hB x (by simp) hxi
      have hsw := Moves.single (MoveStep.swap (S := S) r [] t x htx)
      refine Moves.trans' (b := r ++ [t] ++ [x]) ?_ ?_
      · simpa using hrot
      · simpa using hsw

/-- Lifting a chain of moves past a leaf `t` appended at the end. -/
private lemma moves_lift {S : ReflectionSystem n} {t i : Fin n} {a b : List (Fin n)}
    (h : S.Moves a b) : LeafInv S t i a → S.Moves (a ++ [t]) (b ++ [t]) := by
  induction h with
  | rel _ _ h => exact fun hinv => moveStep_lift h hinv
  | refl => exact fun _ => Moves.refl' S _
  | symm x y hxy ih =>
    intro hy
    exact (ih (LeafInv.of_perm (Moves.perm hxy).symm hy)).symm'
  | trans x y z hxy _ ih₁ ih₂ =>
    intro hx
    exact (ih₁ hx).trans' (ih₂ (LeafInv.of_perm (Moves.perm hxy) hx))

/-! ### Leaves of forests -/

/-- Every nonempty set `s` of nodes of a forest contains a node `t` with at most one
neighbour `i` inside `s`. -/
theorem exists_leaf_of_isAcyclic (S : ReflectionSystem n) (hG : S.diagram.IsAcyclic)
    (s : Finset (Fin n)) (hs : s.Nonempty) :
    ∃ t ∈ s, ∃ i : Fin n, ∀ x ∈ s, x ≠ t → x ≠ i → S.B t x = 0 := by
  classical
  by_cases hiso : ∃ t ∈ s, ∀ x ∈ s, x ≠ t → S.B t x = 0
  · obtain ⟨t, ht, h⟩ := hiso
    exact ⟨t, ht, t, fun x hx hxt _ => h x hx hxt⟩
  push Not at hiso
  obtain ⟨t₀, ht₀⟩ := hs
  obtain ⟨x₀, hx₀, hx₀t, hB₀⟩ := hiso t₀ ht₀
  -- The diagram induced on `s`, as a subgraph of `Γ(B)` on all of `Fin n`.
  let H : SimpleGraph (Fin n) :=
    { Adj := fun x y => x ∈ s ∧ y ∈ s ∧ S.diagram.Adj x y
      symm := ⟨fun x y h => ⟨h.2.1, h.1, h.2.2.symm⟩⟩
      loopless := ⟨fun x h => h.2.2.1 rfl⟩ }
  have hHG : H ≤ S.diagram := fun x y h => h.2.2
  have hH : H.IsAcyclic := hG.anti hHG
  have : Nonempty (Fin n) := ⟨t₀⟩
  obtain ⟨u, v, p, hp, hmax⟩ := SimpleGraph.Walk.exists_isPath_forall_isPath_length_le_length H
  have hedge : H.Adj t₀ x₀ := ⟨ht₀, hx₀, hx₀t.symm, hB₀⟩
  have hlen : 1 ≤ p.length := by
    have := hmax t₀ x₀ (SimpleGraph.Walk.cons hedge SimpleGraph.Walk.nil)
      (by simp [SimpleGraph.Walk.isPath_def, hx₀t.symm])
    simpa using this
  have hnil : ¬ p.Nil := by
    intro h; rw [SimpleGraph.Walk.nil_iff_length_eq] at h; omega
  have hadj := p.adj_snd hnil
  refine ⟨u, hadj.1, p.snd, fun x hx hxu hxs => ?_⟩
  by_contra hBx
  have hux : H.Adj u x := ⟨hadj.1, hx, fun h => hxu h.symm, hBx⟩
  by_cases hsupp : x ∈ p.support
  · exact hxs (hH.eq_snd_of_adj_start hp hux hsupp)
  · have hp' : (SimpleGraph.Walk.cons hux.symm p).IsPath := hp.cons hsupp
    have := hmax x v _ hp'
    simp at this

/-! ### Theorem 2.58 -/

/-- In a forest, any two orderings `l₁`, `l₂` of the same node set `s` are related by
commutation swaps and cyclic rotations. -/
theorem moves_of_isAcyclic (S : ReflectionSystem n) (hG : S.diagram.IsAcyclic) :
    ∀ (k : ℕ) (s : Finset (Fin n)), s.card = k →
      ∀ l₁ l₂ : List (Fin n), l₁.Nodup → l₂.Nodup →
        (∀ x, x ∈ l₁ ↔ x ∈ s) → (∀ x, x ∈ l₂ ↔ x ∈ s) → S.Moves l₁ l₂ := by
  classical
  intro k
  induction k with
  | zero =>
    intro s hs l₁ l₂ _ _ h₁ h₂
    have hs0 : s = ∅ := Finset.card_eq_zero.mp hs
    subst hs0
    have e₁ : l₁ = [] := List.eq_nil_iff_forall_not_mem.mpr fun x hx => by simpa using (h₁ x).mp hx
    have e₂ : l₂ = [] := List.eq_nil_iff_forall_not_mem.mpr fun x hx => by simpa using (h₂ x).mp hx
    subst e₁; subst e₂
    exact Moves.refl' S []
  | succ k ih =>
    intro s hs l₁ l₂ hnd₁ hnd₂ h₁ h₂
    have hne : s.Nonempty := Finset.card_pos.mp (by omega)
    obtain ⟨t, hts, i, hleaf⟩ := exists_leaf_of_isAcyclic S hG s hne
    have hleaf₁ : ∀ x ∈ l₁, x ≠ t → x ≠ i → S.B t x = 0 :=
      fun x hx => hleaf x ((h₁ x).mp hx)
    have hleaf₂ : ∀ x ∈ l₂, x ≠ t → x ≠ i → S.B t x = 0 :=
      fun x hx => hleaf x ((h₂ x).mp hx)
    obtain ⟨u₁, v₁, e₁, m₁⟩ := moves_leaf_to_end S t i l₁ hnd₁ ((h₁ t).mpr hts) hleaf₁
    obtain ⟨u₂, v₂, e₂, m₂⟩ := moves_leaf_to_end S t i l₂ hnd₂ ((h₂ t).mpr hts) hleaf₂
    -- Facts about the shortened words `uⱼ ++ vⱼ`.
    have key : ∀ (l u v : List (Fin n)), l = u ++ t :: v → l.Nodup →
        (∀ x, x ∈ l ↔ x ∈ s) →
        (u ++ v).Nodup ∧ t ∉ u ++ v ∧ (∀ x, x ∈ u ++ v ↔ x ∈ s.erase t) := by
      intro l u v e hnd hmem
      subst e
      have hperm : (u ++ t :: v).Perm (t :: (u ++ v)) := List.perm_middle
      have hnd' := hperm.nodup_iff.mp hnd
      refine ⟨(List.nodup_cons.mp hnd').2, (List.nodup_cons.mp hnd').1, fun x => ?_⟩
      rw [Finset.mem_erase, ← hmem x, hperm.mem_iff, List.mem_cons]
      constructor
      · intro hx
        exact ⟨fun h => (List.nodup_cons.mp hnd').1 (h ▸ hx), Or.inr hx⟩
      · rintro ⟨hxt, hx | hx⟩
        · exact absurd hx hxt
        · exact hx
    obtain ⟨hnda₁, hta₁, hma₁⟩ := key l₁ u₁ v₁ e₁ hnd₁ h₁
    obtain ⟨hnda₂, _, hma₂⟩ := key l₂ u₂ v₂ e₂ hnd₂ h₂
    have hcard : (s.erase t).card = k := by rw [Finset.card_erase_of_mem hts]; omega
    have hmid := ih (s.erase t) hcard (u₁ ++ v₁) (u₂ ++ v₂) hnda₁ hnda₂ hma₁ hma₂
    have hinv : LeafInv S t i (u₁ ++ v₁) :=
      ⟨hnda₁, hta₁, fun x hx hxi =>
        hleaf x (Finset.mem_of_mem_erase ((hma₁ x).mp hx))
          (Finset.ne_of_mem_erase ((hma₁ x).mp hx)) hxi⟩
    have hlift := moves_lift (t := t) (i := i) hmid hinv
    exact m₁.trans' (hlift.trans' m₂.symm')

/-- In a forest, any two principal words are related by commutation swaps and rotations. -/
theorem principal_moves_of_isAcyclic (S : ReflectionSystem n) (hG : S.diagram.IsAcyclic)
    {w₁ w₂ : List (Fin n)} (h₁ : IsPrincipalWord w₁) (h₂ : IsPrincipalWord w₂) :
    S.Moves w₁ w₂ :=
  moves_of_isAcyclic S hG _ Finset.univ rfl w₁ w₂ h₁.1 h₂.1
    (fun x => by simp [h₁.2 x]) (fun x => by simp [h₂.2 x])

/-- **Theorem 2.58 (forests)**: If the reflection diagram `Γ(B)` has no cycles, then all
principal elements of `W(Γ)` lie in a single conjugacy class of `W(Γ)`. -/
theorem theorem_2_58_principal_conj_of_isAcyclic (S : ReflectionSystem n)
    (hG : S.diagram.IsAcyclic) {w₁ w₂ : List (Fin n)}
    (h₁ : IsPrincipalWord w₁) (h₂ : IsPrincipalWord w₂) :
    S.ConjInW (wordProd S w₁) (wordProd S w₂) :=
  (principal_moves_of_isAcyclic S hG h₁ h₂).conjInW

/-- **Theorem 2.58**: If the reflection diagram `Γ(B)` is a tree, then all principal
elements of `W(Γ)` are in the same conjugacy class of `W(Γ)`. -/
theorem theorem_2_58_principal_conj_of_isTree (S : ReflectionSystem n)
    (hG : S.diagram.IsTree) {w₁ w₂ : List (Fin n)}
    (h₁ : IsPrincipalWord w₁) (h₂ : IsPrincipalWord w₂) :
    S.ConjInW (wordProd S w₁) (wordProd S w₂) :=
  theorem_2_58_principal_conj_of_isAcyclic S hG.isAcyclic h₁ h₂

/-- Conjugacy in `W` implies conjugacy in the monoid of `n × n` matrices (`IsConj`). -/
theorem ConjInW.isConj {S : ReflectionSystem n} {a b : Matrix (Fin n) (Fin n) ℝ}
    (h : S.ConjInW a b) : IsConj a b := by
  obtain ⟨c, hc⟩ := h
  refine ⟨⟨wordProd S c, wordProd S c.reverse, wordProd_mul_reverse S c,
    wordProd_reverse_mul S c⟩, ?_⟩
  exact hc

end ReflectionSystem
