import MixedSignCoxeter.ClassicalCoxeterDeletion
import MixedSignCoxeter.RankTwoRoots

/-!
# Proposition 3.10: positive roots and the length function

**Proposition 3.10** of the dissertation states that in a classical Coxeter system
`(W, S, B)`, for every `w ∈ W` and every `sᵢ ∈ S`,
`w(eᵢ) ∈ Φ⁺ ⇔ ℓ(w sᵢ) > ℓ(w)`.
The dissertation cites [BB05] for the proof. This file proves it in full generality for the
matrix group `W(S)` generated by the reflections `sᵢ`, with `ℓ` the word length in `W(S)`
itself. The hypothesis (`IsCoxeterForm`) is `B(eᵢ, eᵢ) = 2` and, for `i ≠ j`, either
`B(eᵢ, eⱼ) = -2 cos(π / m)` with `m ≥ 2` an integer or `B(eᵢ, eⱼ) ≤ -2`. This covers every
classical Coxeter graph (`m(i, j) = ∞` gives `-2`), and also allows any edge weight `≤ -2`.

## Proof outline

This is the argument of Humphreys (*Reflection Groups and Coxeter Groups*, Thm. 5.4),
carried out inside the matrix group, so that no abstract Coxeter group is needed.

1. **Parity.** `det (sᵢ) = -1`, so `ℓ(w sᵢ) = ℓ(w) ± 1`.
2. **Rank two** (`rank_two_coeffs`). If `u` is a word in `sᵢ, sⱼ` with `ℓ(u sᵢ) = |u| + 1`,
   then `u` acts on `eᵢ` like the alternating word `⋯ sᵢ sⱼ` of length `p = |u|`, so
   `u eᵢ = t_{p+1} eᵢ + t_p eⱼ` (or with the two coefficients swapped), where
   `t_k = sin(k π / m) / sin(π / m)` (`chebSeq_mul_sin`). For finite `m` the
   **braid relation** `(sᵢ sⱼ)^m = 1` (`wordProd_altList_two_mul`) shows `p < m`, so both
   coefficients are `≥ 0`; for `B(eᵢ, eⱼ) ≤ -2` they are `≥ k ≥ 0` for every `k`.
3. **Induction on `ℓ(w)`** (`nonneg_of_len_lt`). Factor `w = x · u` with `u` a word in
   `sᵢ, sⱼ` (`sⱼ` the last letter of a reduced word for `w`), `ℓ(w) = ℓ(x) + |u|`, and
   `ℓ(x)` minimal. Minimality gives `ℓ(x sᵢ) > ℓ(x)` and `ℓ(x sⱼ) > ℓ(x)`, so by induction
   `x eᵢ, x eⱼ ≥ 0`; step 2 gives `u eᵢ = α eᵢ + β eⱼ` with `α, β ≥ 0`.
4. **Converse.** If `ℓ(w sᵢ) < ℓ(w)` then `w sᵢ eᵢ = -w eᵢ ≥ 0`, so `w eᵢ` is negative.

## Consequences

* `root_pos_or_neg`: every root `w eᵢ` is positive or negative, `Φ = Φ⁺ ⊔ -Φ⁺`
  (this is exactly what fails for mixed-sign systems, Proposition 3.12).
* `exchange_of_isCoxeterForm`: the Exchange Property holds.
* `isClassicalCoxeter_of_isCoxeterForm`, `classical_graph_isClassicalCoxeter`: combined with
  Theorem 3.9 (`theorem_3_9_isClassicalCoxeter`), the matrix group of every classical Coxeter
  graph is a Coxeter group: the geometric representation is faithful.
-/

open Matrix

namespace MixedSignCoxeter

namespace RootPositivity

open ReflectionSystem

variable {n : ℕ} (S : ReflectionSystem n)

/-! ### Word lemmas -/

lemma wp_nil : S.wordProd [] = 1 := by simp [ReflectionSystem.wordProd]

lemma wp_cons (a : Fin n) (w : List (Fin n)) :
    S.wordProd (a :: w) = reflectionMatrix S.B a * S.wordProd w := by
  simp [ReflectionSystem.wordProd]

lemma wp_append (u v : List (Fin n)) :
    S.wordProd (u ++ v) = S.wordProd u * S.wordProd v := by
  simp [ReflectionSystem.wordProd]

lemma wp_singleton (a : Fin n) : S.wordProd [a] = reflectionMatrix S.B a := by
  simp [ReflectionSystem.wordProd]

lemma wp_mul_reverse (w : List (Fin n)) : S.wordProd w * S.wordProd w.reverse = 1 :=
  prod_map_mul_prod_map_reverse _ (reflectionMatrix_mul_self S) w

lemma wp_reverse_mul (w : List (Fin n)) : S.wordProd w.reverse * S.wordProd w = 1 := by
  simpa using wp_mul_reverse S w.reverse

lemma wp_append_self (w : List (Fin n)) (a : Fin n) :
    S.wordProd (w ++ [a] ++ [a]) = S.wordProd w := by
  rw [wp_append, wp_append, wp_singleton, Matrix.mul_assoc, reflectionMatrix_mul_self,
    Matrix.mul_one]

/-! ### The length function of `W(S)` -/

/-- The length `ℓ(g)` of a matrix `g` in `W(S)`: the length of a shortest word in the
generating reflections whose product is `g` (and `0` if `g ∉ W(S)`). -/
noncomputable def len (g : Matrix (Fin n) (Fin n) ℝ) : ℕ :=
  sInf {k | ∃ w : List (Fin n), w.length = k ∧ S.wordProd w = g}

lemma len_le (w : List (Fin n)) : len S (S.wordProd w) ≤ w.length :=
  Nat.sInf_le ⟨w, rfl, rfl⟩

lemma exists_word_len (w : List (Fin n)) :
    ∃ v : List (Fin n), v.length = len S (S.wordProd w) ∧ S.wordProd v = S.wordProd w :=
  Nat.sInf_mem (s := {k | ∃ v : List (Fin n), v.length = k ∧ S.wordProd v = S.wordProd w})
    ⟨w.length, w, rfl, rfl⟩

lemma len_append_le (u v : List (Fin n)) :
    len S (S.wordProd (u ++ v)) ≤ len S (S.wordProd u) + len S (S.wordProd v) := by
  obtain ⟨u', hu', hu'p⟩ := exists_word_len S u
  obtain ⟨v', hv', hv'p⟩ := exists_word_len S v
  have h : S.wordProd (u' ++ v') = S.wordProd (u ++ v) := by
    rw [wp_append, wp_append, hu'p, hv'p]
  calc len S (S.wordProd (u ++ v)) = len S (S.wordProd (u' ++ v')) := by rw [h]
    _ ≤ (u' ++ v').length := len_le S _
    _ = len S (S.wordProd u) + len S (S.wordProd v) := by
      rw [List.length_append, hu', hv']

lemma len_singleton_le (a : Fin n) : len S (S.wordProd [a]) ≤ 1 := len_le S [a]

lemma wp_eq_one_of_len_eq_zero (w : List (Fin n)) (h : len S (S.wordProd w) = 0) :
    S.wordProd w = 1 := by
  obtain ⟨v, hv, hvp⟩ := exists_word_len S w
  rw [h, List.length_eq_zero_iff] at hv
  rw [← hvp, hv, wp_nil]

lemma det_eq_len (w : List (Fin n)) :
    (S.wordProd w).det = (-1 : ℝ) ^ len S (S.wordProd w) := by
  obtain ⟨v, hv, hvp⟩ := exists_word_len S w
  rw [← hvp, ReflectionSystem.det_wordProd, hv, hvp]

/-- Words whose products have opposite determinants have different lengths. -/
lemma len_ne_of_det_neg {u v : List (Fin n)} (h : (S.wordProd u).det = -(S.wordProd v).det) :
    len S (S.wordProd u) ≠ len S (S.wordProd v) := by
  intro he
  rw [det_eq_len, det_eq_len, he] at h
  have hx : ((-1 : ℝ) ^ len S (S.wordProd v)) ≠ 0 := pow_ne_zero _ (by norm_num)
  apply hx
  linarith

lemma det_append_singleton (w : List (Fin n)) (a : Fin n) :
    (S.wordProd (w ++ [a])).det = -(S.wordProd w).det := by
  rw [wp_append, Matrix.det_mul, wp_singleton, det_reflectionMatrix]
  ring

lemma det_cons (w : List (Fin n)) (a : Fin n) :
    (S.wordProd (a :: w)).det = -(S.wordProd w).det := by
  rw [wp_cons, Matrix.det_mul, det_reflectionMatrix]
  ring

/-- `ℓ(w sₐ) = ℓ(w) ± 1`. -/
lemma len_append_singleton (w : List (Fin n)) (a : Fin n) :
    len S (S.wordProd (w ++ [a])) = len S (S.wordProd w) + 1 ∨
      len S (S.wordProd (w ++ [a])) + 1 = len S (S.wordProd w) := by
  have h1 := len_append_le S w [a]
  have h2 := len_singleton_le S a
  have h3 : len S (S.wordProd w) ≤ len S (S.wordProd (w ++ [a])) + 1 := by
    have := len_append_le S (w ++ [a]) [a]
    rw [wp_append_self] at this
    omega
  have h4 := len_ne_of_det_neg S (det_append_singleton S w a)
  omega

/-- `ℓ(sₐ w) = ℓ(w) ± 1`. -/
lemma len_cons (w : List (Fin n)) (a : Fin n) :
    len S (S.wordProd (a :: w)) = len S (S.wordProd w) + 1 ∨
      len S (S.wordProd (a :: w)) + 1 = len S (S.wordProd w) := by
  have h1 := len_append_le S [a] w
  have h2 := len_singleton_le S a
  have h3 : len S (S.wordProd w) ≤ len S (S.wordProd (a :: w)) + 1 := by
    have := len_append_le S [a] (a :: w)
    have e : S.wordProd ([a] ++ a :: w) = S.wordProd w := by
      rw [wp_append, wp_singleton, wp_cons, ← Matrix.mul_assoc, reflectionMatrix_mul_self,
        Matrix.one_mul]
    rw [e] at this
    omega
  have h4 := len_ne_of_det_neg S (det_cons S w a)
  simp only [List.singleton_append] at h1
  omega

lemma len_reverse_le (w : List (Fin n)) :
    len S (S.wordProd w.reverse) ≤ len S (S.wordProd w) := by
  obtain ⟨v, hv, hvp⟩ := exists_word_len S w
  have h : S.wordProd v.reverse = S.wordProd w.reverse := by
    calc S.wordProd v.reverse
        = S.wordProd v.reverse * (S.wordProd w * S.wordProd w.reverse) := by
          rw [wp_mul_reverse, Matrix.mul_one]
      _ = (S.wordProd v.reverse * S.wordProd v) * S.wordProd w.reverse := by
          rw [hvp, Matrix.mul_assoc]
      _ = S.wordProd w.reverse := by rw [wp_reverse_mul, Matrix.one_mul]
  calc len S (S.wordProd w.reverse) = len S (S.wordProd v.reverse) := by rw [h]
    _ ≤ v.reverse.length := len_le S _
    _ = len S (S.wordProd w) := by rw [List.length_reverse, hv]

/-- `ℓ(w⁻¹) = ℓ(w)`. -/
lemma len_reverse (w : List (Fin n)) :
    len S (S.wordProd w.reverse) = len S (S.wordProd w) := by
  have h1 := len_reverse_le S w
  have h2 := len_reverse_le S w.reverse
  rw [List.reverse_reverse] at h2
  omega

/-- A reduced word has length `ℓ`. -/
lemma len_of_isReduced {w : List (Fin n)} (hw : IsReducedWord S w) :
    len S (S.wordProd w) = w.length := by
  obtain ⟨v, hv, hvp⟩ := exists_word_len S w
  have := len_le S w
  by_contra hne
  exact hw v (by omega) hvp.symm

/-! ### Reflections acting on vectors -/

/-- The standard basis vector `eᵢ`. -/
abbrev e (i : Fin n) : Fin n → ℝ := Pi.single i 1

lemma mulVec_e (M : Matrix (Fin n) (Fin n) ℝ) (j : Fin n) :
    M *ᵥ e j = fun r => M r j := by
  funext r
  simp [mulVec, dotProduct, Pi.single_apply]

lemma e_ne_zero (i : Fin n) : e i ≠ 0 := by
  intro h
  have := congrFun h i
  simp at this

/-- `sᵢ v = v - (2 B(eᵢ, v) / B(eᵢ, eᵢ)) eᵢ`. -/
lemma refl_mulVec (i : Fin n) (v : Fin n → ℝ) :
    reflectionMatrix S.B i *ᵥ v = v - (2 * (S.B *ᵥ v) i / S.B i i) • e i := by
  funext r
  simp only [mulVec, dotProduct, reflectionMatrix_apply, Pi.sub_apply, Pi.smul_apply,
    smul_eq_mul, sub_mul, Finset.sum_sub_distrib, ite_mul, one_mul, zero_mul,
    Finset.sum_ite_eq, Finset.mem_univ, ite_true]
  by_cases hr : r = i
  · subst hr
    simp only [ite_true, Pi.single_eq_same, mul_one]
    rw [Finset.mul_sum, Finset.sum_div]
    congr 1
    refine Finset.sum_congr rfl fun x _ => ?_
    ring
  · simp [hr]

lemma refl_e_self (i : Fin n) (hS : S.B i i ≠ 0) : reflectionMatrix S.B i *ᵥ e i = -e i := by
  rw [refl_mulVec, mulVec_e]
  have : 2 * S.B i i / S.B i i = 2 := by field_simp
  simp only [this]
  funext r
  simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Pi.neg_apply]
  ring

lemma refl_fix (i : Fin n) (v : Fin n → ℝ) (hv : (S.B *ᵥ v) i = 0) :
    reflectionMatrix S.B i *ᵥ v = v := by
  rw [refl_mulVec, hv]
  simp

lemma wp_ne_zero (w : List (Fin n)) (i : Fin n) : S.wordProd w *ᵥ e i ≠ 0 := by
  intro h
  have h2 : (S.wordProd w.reverse * S.wordProd w) *ᵥ e i = 0 := by
    rw [← Matrix.mulVec_mulVec, h, Matrix.mulVec_zero]
  rw [wp_reverse_mul, Matrix.one_mulVec] at h2
  exact e_ne_zero i h2

/-! ### Classical Coxeter forms -/

/-- A **(generalized) classical Coxeter form**: `B(eᵢ, eᵢ) = 2` and, for `i ≠ j`, either
`B(eᵢ, eⱼ) = -2 cos(π / m)` with an integer `m ≥ 2`, or `B(eᵢ, eⱼ) ≤ -2`
(`m(i, j) = ∞` is the case `B(eᵢ, eⱼ) = -2`). -/
def IsCoxeterForm : Prop :=
  (∀ i, S.B i i = 2) ∧ ∀ i j, i ≠ j →
    (∃ m : ℕ, 2 ≤ m ∧ S.B i j = -2 * Real.cos (Real.pi / m)) ∨ S.B i j ≤ -2

/-- A vector is **positive** if it is nonzero with nonnegative coordinates
(Definition 2.13). -/
def IsPositive (v : Fin n → ℝ) : Prop := v ≠ 0 ∧ ∀ r, 0 ≤ v r

/-! ### Chebyshev coefficients -/

/-- `t_k(2 cos θ) · sin θ = sin (k θ)`. -/
lemma chebSeq_mul_sin (θ : ℝ) :
    ∀ k : ℕ, chebSeq (2 * Real.cos θ) k * Real.sin θ = Real.sin (k * θ)
  | 0 => by simp
  | 1 => by simp
  | k + 2 => by
    have e1 := chebSeq_mul_sin θ (k + 1)
    have e0 := chebSeq_mul_sin θ k
    have hs : Real.sin (((k + 2 : ℕ) : ℝ) * θ) =
        2 * Real.cos θ * Real.sin (((k + 1 : ℕ) : ℝ) * θ) - Real.sin ((k : ℝ) * θ) := by
      have h1 : ((k + 2 : ℕ) : ℝ) * θ = ((k + 1 : ℕ) : ℝ) * θ + θ := by push_cast; ring
      have h2 : (k : ℝ) * θ = ((k + 1 : ℕ) : ℝ) * θ - θ := by push_cast; ring
      rw [h1, h2, Real.sin_add, Real.sin_sub]
      ring
    rw [chebSeq_succ_succ, hs]
    linear_combination (2 * Real.cos θ) * e1 - e0

lemma sin_pi_div_pos {m : ℕ} (hm : 2 ≤ m) : 0 < Real.sin (Real.pi / m) := by
  have hm' : (1 : ℝ) < m := by exact_mod_cast (show 1 < m by omega)
  apply Real.sin_pos_of_pos_of_lt_pi
  · have : (0 : ℝ) < m := by linarith
    positivity
  · exact div_lt_self Real.pi_pos hm'

lemma chebSeq_cos_nonneg {m : ℕ} (hm : 2 ≤ m) {k : ℕ} (hk : k ≤ m) :
    0 ≤ chebSeq (2 * Real.cos (Real.pi / m)) k := by
  have hs := sin_pi_div_pos hm
  have h := chebSeq_mul_sin (Real.pi / m) k
  have hm0 : (0 : ℝ) < m := by exact_mod_cast (show 0 < m by omega)
  have hx : 0 ≤ Real.sin (k * (Real.pi / m)) := by
    apply Real.sin_nonneg_of_nonneg_of_le_pi
    · positivity
    · calc (k : ℝ) * (Real.pi / m) ≤ (m : ℝ) * (Real.pi / m) := by
            gcongr
        _ = Real.pi := by field_simp
  by_contra hneg
  push Not at hneg
  nlinarith

lemma chebSeq_cos_two_mul {m : ℕ} (hm : 2 ≤ m) :
    chebSeq (2 * Real.cos (Real.pi / m)) (2 * m) = 0 ∧
      chebSeq (2 * Real.cos (Real.pi / m)) (2 * m + 1) = 1 := by
  have hs := sin_pi_div_pos hm
  have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast (show m ≠ 0 by omega)
  have h0 := chebSeq_mul_sin (Real.pi / m) (2 * m)
  have h1 := chebSeq_mul_sin (Real.pi / m) (2 * m + 1)
  have e0 : ((2 * m : ℕ) : ℝ) * (Real.pi / m) = 2 * Real.pi := by
    push_cast; field_simp
  have e1 : ((2 * m + 1 : ℕ) : ℝ) * (Real.pi / m) = Real.pi / m + 2 * Real.pi := by
    push_cast; field_simp; ring
  rw [e0, Real.sin_two_pi] at h0
  rw [e1, Real.sin_add_two_pi] at h1
  constructor
  · rcases mul_eq_zero.mp h0 with h | h
    · exact h
    · exact absurd h hs.ne'
  · have := mul_right_cancel₀ hs.ne' (h1.trans (one_mul _).symm)
    exact this

/-! ### Alternating words -/

/-- The alternating word `⋯ sᵢ sⱼ` of length `k` (last letter `j`), built by consing on the
left exactly like `ReflectionSystem.altWord`. -/
def altList (i j : Fin n) : ℕ → List (Fin n)
  | 0 => []
  | k + 1 => (if k % 2 = 0 then j else i) :: altList i j k

lemma altList_succ (i j : Fin n) (k : ℕ) :
    altList i j (k + 1) = (if k % 2 = 0 then j else i) :: altList i j k := rfl

@[simp] lemma length_altList (i j : Fin n) (k : ℕ) : (altList i j k).length = k := by
  induction k with
  | zero => rfl
  | succ k ih => simp [altList_succ, ih]

lemma wordProd_altList (i j : Fin n) (k : ℕ) :
    S.wordProd (altList i j k) = ReflectionSystem.altWord S i j k := by
  induction k with
  | zero => rw [show altList i j 0 = [] from rfl, wp_nil]; rfl
  | succ k ih =>
    rw [altList_succ, wp_cons, ih, ReflectionSystem.altWord_succ]
    split_ifs <;> rfl

lemma altList_append (i j : Fin n) : ∀ k, altList i j k ++ [i] = altList j i (k + 1)
  | 0 => rfl
  | k + 1 => by
    rw [altList_succ, List.cons_append, altList_append i j k, altList_succ j i (k + 1)]
    congr 1
    split_ifs <;> first | rfl | omega

lemma altList_add (i j : Fin n) (q : ℕ) :
    ∀ r, ∃ Z : List (Fin n), Z.length = r ∧ altList i j (q + r) = Z ++ altList i j q
  | 0 => ⟨[], rfl, by simp⟩
  | r + 1 => by
    obtain ⟨Z, hZ, h⟩ := altList_add i j q r
    refine ⟨(if (q + r) % 2 = 0 then j else i) :: Z, by simp [hZ], ?_⟩
    rw [show q + (r + 1) = (q + r) + 1 by omega, altList_succ, h]
    rfl

variable {S}

/-- The `c`-parameter `-2 B(eᵢ, eⱼ) / B(eᵢ, eᵢ)` is the same from both ends. -/
lemma coeff_symm (hS : IsCoxeterForm S) (i j : Fin n) :
    -2 * S.B j i / S.B j j = -2 * S.B i j / S.B i i := by
  rw [hS.1 i, hS.1 j, S.B_symm.apply i j]

lemma pow_mulVec_fixed (P : Matrix (Fin n) (Fin n) ℝ) (w : Fin n → ℝ) (h : P *ᵥ w = w) :
    ∀ k : ℕ, P ^ k *ᵥ w = w
  | 0 => by simp
  | k + 1 => by rw [pow_succ, ← Matrix.mulVec_mulVec, h, pow_mulVec_fixed P w h k]

/-- **Braid relation**: if `B(eᵢ, eⱼ) = -2 cos(π / m)` then `(sᵢ sⱼ)^m = 1`. -/
theorem wordProd_altList_two_mul (hS : IsCoxeterForm S) {i j : Fin n} (hij : i ≠ j)
    {m : ℕ} (hm : 2 ≤ m) (hB : S.B i j = -2 * Real.cos (Real.pi / m)) :
    S.wordProd (altList i j (2 * m)) = 1 := by
  set c := 2 * Real.cos (Real.pi / m) with hc
  have hci : -2 * S.B i j / S.B i i = c := by rw [hS.1 i, hB]; ring
  have hcj : -2 * S.B j i / S.B j j = c := by rw [coeff_symm hS, hci]
  have hBji : S.B j i = -c := by rw [S.B_symm.apply i j, hB, hc]; ring
  have hBij : S.B i j = -c := by rw [hB, hc]; ring
  obtain ⟨t0, t1⟩ := chebSeq_cos_two_mul hm
  rw [wordProd_altList, ReflectionSystem.altWord_even]
  set P := reflectionMatrix S.B i * reflectionMatrix S.B j with hP
  set Q := reflectionMatrix S.B j * reflectionMatrix S.B i with hQ
  -- `P^m eᵢ = eᵢ`
  have hPi : P ^ m *ᵥ e i = e i := by
    have h := ReflectionSystem.alternating_word_root S hij c hci hcj (2 * m)
    rw [ReflectionSystem.altWord_even] at h
    simp only [Nat.mul_mod_right, ite_true] at h
    rw [h, t0, t1, ReflectionSystem.pairVec_single hij]
  -- `Q^m eⱼ = eⱼ`
  have hQj : Q ^ m *ᵥ e j = e j := by
    have h := ReflectionSystem.alternating_word_root S hij.symm c hcj hci (2 * m)
    rw [ReflectionSystem.altWord_even] at h
    simp only [Nat.mul_mod_right, ite_true] at h
    rw [h, t0, t1, ReflectionSystem.pairVec_single hij.symm]
  have hPQ : P * Q = 1 := by
    rw [hP, hQ, Matrix.mul_assoc, ← Matrix.mul_assoc (reflectionMatrix S.B j),
      reflectionMatrix_mul_self, Matrix.one_mul, reflectionMatrix_mul_self]
  have hQP : Q * P = 1 := by
    rw [hP, hQ, Matrix.mul_assoc, ← Matrix.mul_assoc (reflectionMatrix S.B i),
      reflectionMatrix_mul_self, Matrix.one_mul, reflectionMatrix_mul_self]
  have hPmQm : P ^ m * Q ^ m = 1 := by
    rw [← (show Commute P Q from hPQ.trans hQP.symm).mul_pow, hPQ, one_pow]
  have hPj : P ^ m *ᵥ e j = e j := by
    calc P ^ m *ᵥ e j = P ^ m *ᵥ (Q ^ m *ᵥ e j) := by rw [hQj]
      _ = e j := by rw [Matrix.mulVec_mulVec, hPmQm, Matrix.one_mulVec]
  -- vectors orthogonal to `eᵢ, eⱼ` are fixed
  have hfix : ∀ w : Fin n → ℝ, (S.B *ᵥ w) i = 0 → (S.B *ᵥ w) j = 0 → P ^ m *ᵥ w = w := by
    intro w hwi hwj
    have hPw : P *ᵥ w = w := by
      rw [hP, ← Matrix.mulVec_mulVec, refl_fix S j w hwj, refl_fix S i w hwi]
    exact pow_mulVec_fixed P w hPw m
  -- `4 - c² > 0`
  have hden : 4 - c ^ 2 ≠ 0 := by
    have hs := sin_pi_div_pos hm
    have : 4 - c ^ 2 = 4 * Real.sin (Real.pi / m) ^ 2 := by
      rw [hc, Real.sin_sq]; ring
    rw [this]
    positivity
  have hall : ∀ v : Fin n → ℝ, P ^ m *ᵥ v = v := by
    intro v
    set x := (S.B *ᵥ v) i
    set y := (S.B *ᵥ v) j
    set lam := (2 * x + c * y) / (4 - c ^ 2)
    set mu := (2 * y + c * x) / (4 - c ^ 2)
    set w := v - lam • e i - mu • e j with hw
    have hBe : ∀ a b : Fin n, (S.B *ᵥ e b) a = S.B a b := fun a b => by rw [mulVec_e]
    have hwi : (S.B *ᵥ w) i = 0 := by
      rw [hw, Matrix.mulVec_sub, Matrix.mulVec_sub, Matrix.mulVec_smul, Matrix.mulVec_smul]
      simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, hBe, hS.1 i, hBij, lam, mu, x, y]
      field_simp
      ring
    have hwj : (S.B *ᵥ w) j = 0 := by
      rw [hw, Matrix.mulVec_sub, Matrix.mulVec_sub, Matrix.mulVec_smul, Matrix.mulVec_smul]
      simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, hBe, hS.1 j, hBji, lam, mu, x, y]
      field_simp
      ring
    have hv : v = w + lam • e i + mu • e j := by
      rw [hw]; abel
    rw [hv, Matrix.mulVec_add, Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul,
      hfix w hwi hwj, hPi, hPj]
  ext r c'
  have := congrFun (hall (e c')) r
  rw [mulVec_e] at this
  simp only [this, Pi.single_apply, Matrix.one_apply]

/-- For finite `m`, an alternating word of length `q > m` is not reduced. -/
lemma len_altList_lt (hS : IsCoxeterForm S) {i j : Fin n} (hij : i ≠ j)
    {m : ℕ} (hm : 2 ≤ m) (hB : S.B i j = -2 * Real.cos (Real.pi / m))
    {q : ℕ} (hq : m < q) : len S (S.wordProd (altList i j q)) < q := by
  have hbraid := wordProd_altList_two_mul hS hij hm hB
  by_cases hq2 : q ≤ 2 * m
  · obtain ⟨Z, hZ, hsplit⟩ := altList_add i j q (2 * m - q)
    rw [show q + (2 * m - q) = 2 * m by omega] at hsplit
    have h1 : S.wordProd Z * S.wordProd (altList i j q) = 1 := by
      rw [← wp_append, ← hsplit, hbraid]
    have h2 : S.wordProd (altList i j q) = S.wordProd Z.reverse := by
      calc S.wordProd (altList i j q)
          = (S.wordProd Z.reverse * S.wordProd Z) * S.wordProd (altList i j q) := by
            rw [wp_reverse_mul, Matrix.one_mul]
        _ = S.wordProd Z.reverse := by rw [Matrix.mul_assoc, h1, Matrix.mul_one]
    have := len_le S Z.reverse
    rw [← h2, List.length_reverse, hZ] at this
    omega
  · obtain ⟨Z, hZ, hsplit⟩ := altList_add i j (2 * m) (q - 2 * m)
    rw [show 2 * m + (q - 2 * m) = q by omega] at hsplit
    have h2 : S.wordProd (altList i j q) = S.wordProd Z := by
      rw [hsplit, wp_append, hbraid, Matrix.mul_one]
    have := len_le S Z
    rw [← h2, hZ] at this
    omega

/-- A word `u` in `sᵢ, sⱼ` with `ℓ(u sᵢ) = |u| + 1` equals the alternating word `⋯ sᵢ sⱼ`
of the same length. -/
lemma wordProd_eq_altList {i j : Fin n} (hij : i ≠ j) :
    ∀ u : List (Fin n), (∀ a ∈ u, a = i ∨ a = j) →
      len S (S.wordProd (u ++ [i])) = u.length + 1 →
      S.wordProd u = S.wordProd (altList i j u.length)
  | [], _, _ => rfl
  | a :: u', hu, hlen => by
    have hu' : ∀ b ∈ u', b = i ∨ b = j := fun b hb => hu b (List.mem_cons_of_mem a hb)
    have hlen' : len S (S.wordProd (u' ++ [i])) = u'.length + 1 := by
      have h1 := len_le S (u' ++ [i])
      have h2 := len_append_le S [a] (u' ++ [i])
      have h3 := len_singleton_le S a
      simp only [List.length_append, List.length_singleton] at h1
      simp only [List.singleton_append] at h2
      rw [List.cons_append, List.length_cons] at hlen
      omega
    have ih := wordProd_eq_altList hij u' hu' hlen'
    rw [List.length_cons, altList_succ, wp_cons, wp_cons, ih]
    by_cases hax : a = (if u'.length % 2 = 0 then j else i)
    · rw [← hax]
    · exfalso
      rcases hk : u'.length with _ | k
      · -- `u' = []`, so `a = i` and `u sᵢ = sᵢ sᵢ = 1`
        rw [hk] at hax
        have hai : a = i := by
          rcases hu a List.mem_cons_self with h | h
          · exact h
          · simp at hax; exact absurd h hax
        have hu'nil : u' = [] := List.length_eq_zero_iff.mp hk
        subst hu'nil hai
        have e1 : S.wordProd ([a] ++ [a]) = S.wordProd [] := by
          simpa using wp_append_self S [] a
        have := len_le S ([] : List (Fin n))
        rw [← e1] at this
        simp at hlen this
        omega
      · -- `a` cancels the first letter of the alternating word
        rw [hk] at hax ih
        have hy : a = (if k % 2 = 0 then j else i) := by
          rcases hu a List.mem_cons_self with h | h <;> subst h <;>
            split_ifs at hax ⊢ <;> first | rfl | omega
        have e1 : S.wordProd ((a :: u') ++ [i]) = S.wordProd (altList i j k ++ [i]) := by
          rw [List.cons_append, wp_cons, wp_append, ih, altList_succ, wp_cons, ← hy,
            wp_append, ← Matrix.mul_assoc, ← Matrix.mul_assoc, reflectionMatrix_mul_self,
            Matrix.one_mul]
        have := len_le S (altList i j k ++ [i])
        rw [← e1] at this
        simp only [List.length_append, length_altList, List.length_singleton] at this
        rw [hlen, List.length_cons, hk] at this
        omega

/-- **Rank-two step**: if `u` is a word in `sᵢ, sⱼ` with `ℓ(u sᵢ) = |u| + 1`, then
`u eᵢ = α eᵢ + β eⱼ` with `α, β ≥ 0`. -/
theorem rank_two_coeffs (hS : IsCoxeterForm S) {i j : Fin n} (hij : i ≠ j)
    (u : List (Fin n)) (hu : ∀ a ∈ u, a = i ∨ a = j)
    (hlen : len S (S.wordProd (u ++ [i])) = u.length + 1) :
    ∃ α β : ℝ, 0 ≤ α ∧ 0 ≤ β ∧ S.wordProd u *ᵥ e i = pairVec i j α β := by
  have halt := wordProd_eq_altList hij u hu hlen
  set p := u.length with hp
  set c := -2 * S.B i j / S.B i i with hc
  have hcj : -2 * S.B j i / S.B j j = c := coeff_symm hS i j
  have hroot := ReflectionSystem.alternating_word_root S hij c hc.symm hcj p
  -- both coefficients `t_p, t_{p+1}` are nonnegative
  have hnn : 0 ≤ chebSeq c p ∧ 0 ≤ chebSeq c (p + 1) := by
    rcases hS.2 i j hij with ⟨m, hm, hB⟩ | hB
    · have hcm : c = 2 * Real.cos (Real.pi / m) := by rw [hc, hS.1 i, hB]; ring
      have hpm : p + 1 ≤ m := by
        by_contra hpm
        have hlt := len_altList_lt hS hij.symm hm
          (by rw [S.B_symm.apply i j]; exact hB) (show m < p + 1 by omega)
        have e1 : S.wordProd (u ++ [i]) = S.wordProd (altList j i (p + 1)) := by
          rw [← altList_append, wp_append, wp_append, halt]
        rw [← e1, hlen] at hlt
        omega
      rw [hcm]
      exact ⟨chebSeq_cos_nonneg hm (by omega), chebSeq_cos_nonneg hm hpm⟩
    · have hc2 : 2 ≤ c := by rw [hc, hS.1 i]; linarith
      exact ⟨le_trans (Nat.cast_nonneg _) (chebSeq_ge c hc2 p),
        le_trans (Nat.cast_nonneg _) (chebSeq_ge c hc2 (p + 1))⟩
  rw [halt, wordProd_altList, hroot]
  split_ifs
  · exact ⟨_, _, hnn.2, hnn.1, rfl⟩
  · exact ⟨_, _, hnn.1, hnn.2, rfl⟩

lemma pairVec_eq (i j : Fin n) (α β : ℝ) : pairVec i j α β = α • e i + β • e j := by
  funext r
  simp [pairVec, Pi.single_apply]

/-! ### Proposition 3.10 -/

/-- **Proposition 3.10, `(⇐)`**: if `ℓ(w sᵢ) > ℓ(w)` then every coordinate of `w eᵢ` is
nonnegative. Proved by strong induction on `ℓ(w)`. -/
theorem nonneg_of_len_lt (hS : IsCoxeterForm S) :
    ∀ N : ℕ, ∀ w : List (Fin n), len S (S.wordProd w) = N → ∀ i : Fin n,
      len S (S.wordProd w) < len S (S.wordProd (w ++ [i])) →
      ∀ r, 0 ≤ (S.wordProd w *ᵥ e i) r := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
  intro w hwN i hlt
  rcases Nat.eq_zero_or_pos N with h0 | hpos
  · have h1 : S.wordProd w = 1 := wp_eq_one_of_len_eq_zero S w (hwN.trans h0)
    intro r
    rw [h1, Matrix.one_mulVec]
    simp only [e, Pi.single_apply]
    split_ifs <;> norm_num
  -- a reduced word `v' sⱼ` for `w`
  obtain ⟨v, hvlen, hvp⟩ := exists_word_len S w
  have hne : v ≠ [] := by
    rintro rfl
    simp at hvlen
    omega
  obtain ⟨v', j, rfl⟩ : ∃ v' j, v = v' ++ [j] :=
    ⟨v.dropLast, v.getLast hne, (List.dropLast_append_getLast hne).symm⟩
  simp only [List.length_append, List.length_singleton] at hvlen
  have hv'len : len S (S.wordProd v') = N - 1 := by
    have h1 := len_le S v'
    have h2 := len_append_le S v' [j]
    have h3 := len_singleton_le S j
    rw [hvp] at h2
    omega
  have hji : j ≠ i := by
    rintro rfl
    have e1 : S.wordProd (w ++ [j]) = S.wordProd v' := by
      rw [wp_append, ← hvp, ← wp_append, wp_append_self]
    rw [e1] at hlt
    omega
  -- choose a factorization `w = x · u`, `u ∈ ⟨sᵢ, sⱼ⟩`, `ℓ(w) = ℓ(x) + |u|`, `ℓ(x)` minimal
  classical
  let P : ℕ → Prop := fun k => ∃ x u : List (Fin n), (∀ a ∈ u, a = i ∨ a = j) ∧
    S.wordProd (x ++ u) = S.wordProd w ∧ len S (S.wordProd x) = k ∧ k + u.length = N
  have hP : ∃ k, P k := ⟨N - 1, v', [j], by simp, hvp, hv'len, by simp; omega⟩
  obtain ⟨x, u, hu, hxu, hxk, hkN⟩ := Nat.find_spec hP
  have hmin : ∀ k < Nat.find hP, ¬ P k := fun k hk => Nat.find_min hP hk
  have hk0 : Nat.find hP ≤ N - 1 := Nat.find_min' hP ⟨v', [j], by simp, hvp, hv'len, by simp; omega⟩
  set k0 := Nat.find hP with hk0def
  -- minimality: `ℓ(x sₐ) > ℓ(x)` for `a ∈ {i, j}`
  have hxa : ∀ a, (a = i ∨ a = j) →
      len S (S.wordProd x) < len S (S.wordProd (x ++ [a])) := by
    intro a ha
    rcases len_append_singleton S x a with h | h
    · omega
    · exfalso
      apply hmin (k0 - 1) (by omega)
      refine ⟨x ++ [a], a :: u, ?_, ?_, by omega, by simp; omega⟩
      · intro b hb
        rcases List.mem_cons.mp hb with rfl | hb
        · exact ha
        · exact hu b hb
      · rw [← hxu, show x ++ [a] ++ a :: u = (x ++ [a] ++ [a]) ++ u by simp, wp_append,
          wp_append_self, ← wp_append]
  have hxi := ih k0 (by omega) x hxk i (hxa i (Or.inl rfl))
  have hxj := ih k0 (by omega) x hxk j (hxa j (Or.inr rfl))
  -- `u` is reduced and `ℓ(u sᵢ) = |u| + 1`
  have hwlen : len S (S.wordProd (x ++ u)) = N := by rw [hxu, hwN]
  have hulen : len S (S.wordProd u) = u.length := by
    have h1 := len_le S u
    have h2 := len_append_le S x u
    omega
  have hui : len S (S.wordProd (u ++ [i])) = u.length + 1 := by
    rcases len_append_singleton S u i with h | h
    · omega
    · exfalso
      have h1 := len_append_le S x (u ++ [i])
      have e1 : S.wordProd (x ++ (u ++ [i])) = S.wordProd (w ++ [i]) := by
        rw [← List.append_assoc, wp_append, hxu, ← wp_append]
      rw [e1] at h1
      omega
  obtain ⟨α, β, hα, hβ, hvec⟩ := rank_two_coeffs hS hji.symm u hu hui
  intro r
  rw [← hxu, wp_append, ← Matrix.mulVec_mulVec, hvec, pairVec_eq, Matrix.mulVec_add,
    Matrix.mulVec_smul, Matrix.mulVec_smul]
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  have := hxi r
  have := hxj r
  positivity

/-- If `ℓ(w sᵢ) < ℓ(w)` then every coordinate of `w eᵢ` is nonpositive. -/
theorem nonpos_of_len_lt (hS : IsCoxeterForm S) (w : List (Fin n)) (i : Fin n)
    (h : len S (S.wordProd (w ++ [i])) < len S (S.wordProd w)) :
    ∀ r, (S.wordProd w *ᵥ e i) r ≤ 0 := by
  have h2 : len S (S.wordProd (w ++ [i])) < len S (S.wordProd (w ++ [i] ++ [i])) := by
    rw [wp_append_self]; exact h
  have hnn := nonneg_of_len_lt hS _ (w ++ [i]) rfl i h2
  intro r
  have := hnn r
  rw [wp_append, wp_singleton, ← Matrix.mulVec_mulVec, refl_e_self S i (by rw [hS.1 i]; norm_num),
    Matrix.mulVec_neg] at this
  simp only [Pi.neg_apply] at this
  linarith

lemma len_wp_mul (w : List (Fin n)) (i : Fin n) :
    S.wordProd w * reflectionMatrix S.B i = S.wordProd (w ++ [i]) := by
  rw [wp_append, wp_singleton]

/-- **Proposition 3.10**: in a classical Coxeter system, for every `w ∈ W` and `sᵢ ∈ S`,
`w(eᵢ) ∈ Φ⁺ ⇔ ℓ(w sᵢ) > ℓ(w)`. Here `W = W(S)` is the matrix group generated by the
reflections and `ℓ` is the word length in `W(S)`. -/
theorem prop_3_10 (hS : IsCoxeterForm S) (w : List (Fin n)) (i : Fin n) :
    IsPositive (S.wordProd w *ᵥ e i) ↔
      len S (S.wordProd w) < len S (S.wordProd w * reflectionMatrix S.B i) := by
  rw [len_wp_mul]
  constructor
  · rintro ⟨hne, hpos⟩
    by_contra hle
    have hlt : len S (S.wordProd (w ++ [i])) < len S (S.wordProd w) := by
      rcases len_append_singleton S w i with h | h <;> omega
    apply hne
    funext r
    exact le_antisymm (nonpos_of_len_lt hS w i hlt r) (hpos r)
  · intro h
    exact ⟨wp_ne_zero S w i, nonneg_of_len_lt hS _ w rfl i h⟩

/-- `Φ = Φ⁺ ⊔ -Φ⁺`: every root `w eᵢ` of a classical Coxeter system is positive or negative,
according as `ℓ(w sᵢ) > ℓ(w)` or `ℓ(w sᵢ) < ℓ(w)`. Compare Proposition 3.12, which shows that
this fails for the mixed-sign system `A₂(-, +)`. -/
theorem root_pos_or_neg (hS : IsCoxeterForm S) (w : List (Fin n)) (i : Fin n) :
    IsPositive (S.wordProd w *ᵥ e i) ∨ IsPositive (-(S.wordProd w *ᵥ e i)) := by
  rcases len_append_singleton S w i with h | h
  · left
    rw [prop_3_10 hS, len_wp_mul]
    omega
  · right
    refine ⟨neg_ne_zero.mpr (wp_ne_zero S w i), fun r => ?_⟩
    have := nonpos_of_len_lt hS w i (by omega) r
    simp only [Pi.neg_apply]
    linarith

/-- A root is never both positive and negative. -/
theorem not_pos_and_neg (v : Fin n → ℝ) (h1 : IsPositive v) (h2 : IsPositive (-v)) : False := by
  apply h1.1
  funext r
  have a := h1.2 r
  have b := h2.2 r
  simp only [Pi.neg_apply] at b
  simp only [Pi.zero_apply]
  linarith

/-! ### The Exchange Property and faithfulness -/

lemma wp_preserves_B (y : List (Fin n)) :
    (S.wordProd y)ᵀ * S.B * S.wordProd y = S.B := by
  induction y with
  | nil => simp [wp_nil]
  | cons a y ih =>
    rw [wp_cons, Matrix.transpose_mul]
    calc (S.wordProd y)ᵀ * (reflectionMatrix S.B a)ᵀ * S.B *
          (reflectionMatrix S.B a * S.wordProd y)
        = (S.wordProd y)ᵀ * ((reflectionMatrix S.B a)ᵀ * S.B * reflectionMatrix S.B a) *
          S.wordProd y := by simp only [Matrix.mul_assoc]
      _ = S.B := by rw [reflectionMatrix_preserves_B, ih]

lemma dot_invariant (g B : Matrix (Fin n) (Fin n) ℝ) (x y : Fin n → ℝ) :
    (g *ᵥ x) ⬝ᵥ (B *ᵥ (g *ᵥ y)) = x ⬝ᵥ ((gᵀ * B * g) *ᵥ y) := by
  rw [Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec, ← Matrix.vecMul_transpose,
    Matrix.vecMul_vecMul, ← Matrix.dotProduct_mulVec, Matrix.mul_assoc]

lemma dot_e (v : Fin n → ℝ) (a : Fin n) : e a ⬝ᵥ v = v a := by
  simp [dotProduct, Pi.single_apply]

/-- If `g eᵦ = λ eₐ` for `g ∈ W(S)`, then `g sᵦ = sₐ g`. -/
lemma conj_of_root_eq (hS : IsCoxeterForm S) (y : List (Fin n)) (a b : Fin n) (lam : ℝ)
    (hroot : S.wordProd y *ᵥ e b = lam • e a) :
    S.wordProd y * reflectionMatrix S.B b = reflectionMatrix S.B a * S.wordProd y := by
  set g := S.wordProd y with hg
  have hinv := wp_preserves_B (S := S) y
  rw [← hg] at hinv
  have hBe : ∀ v : Fin n → ℝ, (S.B *ᵥ v) a = e a ⬝ᵥ (S.B *ᵥ v) := fun v => (dot_e _ a).symm
  -- `λ² = 1`
  have hlam : lam * lam = 1 := by
    have h := dot_invariant g S.B (e b) (e b)
    rw [hinv, hroot, Matrix.mulVec_smul, dotProduct_smul, smul_dotProduct, dot_e, dot_e,
      mulVec_e, mulVec_e] at h
    simp only [smul_eq_mul, hS.1 a, hS.1 b] at h
    linarith
  -- `B(eₐ, g v) = λ B(eᵦ, v)`
  have hkey : ∀ v : Fin n → ℝ, (S.B *ᵥ (g *ᵥ v)) a = lam * (S.B *ᵥ v) b := by
    intro v
    have h := dot_invariant g S.B (e b) v
    rw [hinv, hroot, smul_dotProduct, dot_e, dot_e, smul_eq_mul] at h
    calc (S.B *ᵥ (g *ᵥ v)) a = (lam * lam) * (S.B *ᵥ (g *ᵥ v)) a := by rw [hlam, one_mul]
      _ = lam * (S.B *ᵥ v) b := by rw [mul_assoc, h]
  have hall : ∀ v, (g * reflectionMatrix S.B b) *ᵥ v = (reflectionMatrix S.B a * g) *ᵥ v := by
    intro v
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, refl_mulVec, refl_mulVec,
      Matrix.mulVec_sub, Matrix.mulVec_smul, hroot, hkey, hS.1 a, hS.1 b, smul_smul]
    congr 2
    field_simp
  ext r c
  have := hall (e c)
  rw [mulVec_e, mulVec_e] at this
  exact congrFun this r

/-- If `v = y eₛ` is a nonnegative root and `sₐ v` is not nonnegative, then `v = λ eₐ`. -/
lemma root_eq_smul (hS : IsCoxeterForm S) (y : List (Fin n)) (s a : Fin n)
    (hv : ∀ r, 0 ≤ (S.wordProd y *ᵥ e s) r)
    (hav : ¬ ∀ r, 0 ≤ (S.wordProd (a :: y) *ᵥ e s) r) :
    S.wordProd y *ᵥ e s = (S.wordProd y *ᵥ e s) a • e a := by
  have hneg : IsPositive (-(S.wordProd (a :: y) *ᵥ e s)) := by
    rcases root_pos_or_neg hS (a :: y) s with h | h
    · exact absurd h.2 hav
    · exact h
  funext r
  by_cases hr : r = a
  · subst hr; simp
  · have h1 := hneg.2 r
    rw [wp_cons, ← Matrix.mulVec_mulVec, refl_mulVec] at h1
    simp only [Pi.neg_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Pi.single_apply, hr,
      ite_false, mul_zero, sub_zero] at h1
    have h2 := hv r
    simp only [Pi.smul_apply, smul_eq_mul, Pi.single_apply, hr, ite_false, mul_zero]
    linarith

/-- **Exchange Property** for every classical Coxeter form, derived from Proposition 3.10. -/
theorem exchange_of_isCoxeterForm (hS : IsCoxeterForm S) : SatisfiesExchangeProperty S := by
  intro s w hw ⟨u, hu, hsu⟩
  have hwl := len_of_isReduced S hw
  have hsl : len S (S.wordProd (s :: w)) < w.length := by
    have h1 := len_le S u
    rw [← hsu] at h1
    have h2 := len_ne_of_det_neg S (det_cons S w s)
    have h3 := len_cons S w s
    simp only [List.length_cons] at hu
    omega
  -- `w⁻¹ eₛ` is negative
  have hrev : len S (S.wordProd (w.reverse ++ [s])) < len S (S.wordProd w.reverse) := by
    rw [← List.reverse_cons, len_reverse, len_reverse, hwl]
    exact hsl
  have hneg := nonpos_of_len_lt hS w.reverse s hrev
  have hne := wp_ne_zero S w.reverse s
  -- the prefixes `x_t = (w₁ ⋯ w_t)⁻¹ eₛ`
  classical
  let X : ℕ → Prop := fun t => ¬ ∀ r, 0 ≤ (S.wordProd (w.take t).reverse *ᵥ e s) r
  have hX : ∃ t, X t := by
    refine ⟨w.length, fun h => hne ?_⟩
    rw [List.take_length] at h
    funext r
    exact le_antisymm (hneg r) (h r)
  have ht1pos : Nat.find hX ≠ 0 := by
    intro h0
    have := Nat.find_spec hX
    rw [h0] at this
    apply this
    intro r
    simp only [List.take_zero, List.reverse_nil, wp_nil, Matrix.one_mulVec, e, Pi.single_apply]
    split_ifs <;> norm_num
  obtain ⟨t, ht1⟩ : ∃ t, Nat.find hX = t + 1 := ⟨Nat.find hX - 1, by omega⟩
  have hXt1 : X (t + 1) := ht1 ▸ Nat.find_spec hX
  have hXt : ¬ X t := Nat.find_min hX (by omega)
  have ht : t < w.length := by
    by_contra htl
    apply hXt
    have e1 : w.take (t + 1) = w.take t := by
      rw [List.take_of_length_le (by omega), List.take_of_length_le (by omega)]
    show ¬ ∀ r, 0 ≤ (S.wordProd (w.take t).reverse *ᵥ e s) r
    rw [← e1]
    exact hXt1
  -- split `w = P ++ a :: R` with `|P| = t`
  set P := w.take t with hPdef
  set a := w[t] with hadef
  set R := w.drop (t + 1) with hRdef
  have hw : w = P ++ a :: R := by
    rw [hPdef, hadef, hRdef, ← List.drop_eq_getElem_cons ht, List.take_append_drop]
  have herase : w.eraseIdx t = P ++ R := by
    rw [List.eraseIdx_eq_take_drop_succ]
  have htake : (w.take (t + 1)).reverse = a :: P.reverse := by
    rw [List.take_add_one, List.getElem?_eq_getElem ht]
    simp [hPdef, hadef]
  have hXt' : ∀ r, 0 ≤ (S.wordProd P.reverse *ᵥ e s) r := by
    by_contra h
    exact hXt h
  have hXt1' : ¬ ∀ r, 0 ≤ (S.wordProd (a :: P.reverse) *ᵥ e s) r := by
    rw [← htake]
    exact hXt1
  have hroot := root_eq_smul hS P.reverse s a hXt' hXt1'
  have hconj := conj_of_root_eq hS P.reverse a s _ hroot
  -- `sₛ P = P sₐ`
  have hsP : reflectionMatrix S.B s * S.wordProd P = S.wordProd P * reflectionMatrix S.B a := by
    calc reflectionMatrix S.B s * S.wordProd P
        = (S.wordProd P * S.wordProd P.reverse) * reflectionMatrix S.B s * S.wordProd P := by
          rw [wp_mul_reverse, Matrix.one_mul]
      _ = S.wordProd P * (S.wordProd P.reverse * reflectionMatrix S.B s) * S.wordProd P := by
          simp only [Matrix.mul_assoc]
      _ = S.wordProd P * (reflectionMatrix S.B a * S.wordProd P.reverse) * S.wordProd P := by
          rw [hconj]
      _ = S.wordProd P * reflectionMatrix S.B a := by
          rw [Matrix.mul_assoc, Matrix.mul_assoc, wp_reverse_mul, Matrix.mul_one]
  refine ⟨t, ht, ?_⟩
  rw [herase]
  conv_lhs => rw [hw]
  rw [wp_cons, wp_append, wp_cons, wp_append, ← Matrix.mul_assoc, hsP, Matrix.mul_assoc,
    ← Matrix.mul_assoc (reflectionMatrix S.B a), reflectionMatrix_mul_self, Matrix.one_mul]

/-- **Deletion Property** for every classical Coxeter form. -/
theorem deletion_of_isCoxeterForm (hS : IsCoxeterForm S) : SatisfiesDeletionProperty S :=
  (deletion_iff_exchange S).2 (exchange_of_isCoxeterForm hS)

/-- **Faithfulness of the geometric representation.** For every classical Coxeter form, the
matrix group `W(S)` is a Coxeter group: by Theorem 3.9 there is a Coxeter matrix `M` and an
injective homomorphism `M.Group →* GL` sending each Coxeter generator to `sᵢ`. -/
theorem isClassicalCoxeter_of_isCoxeterForm (hS : IsCoxeterForm S) :
    ∃ (M : CoxeterMatrix (Fin n)) (φ : M.Group →* Matrix (Fin n) (Fin n) ℝ),
      Function.Injective φ ∧ ∀ i, φ (M.toCoxeterSystem.simple i) = reflectionMatrix S.B i :=
  theorem_3_9_isClassicalCoxeter S (deletion_of_isCoxeterForm hS)

/-! ### Classical Coxeter graphs -/

/-- The bilinear form of a classical Coxeter graph (all nodes `+`) is a Coxeter form. -/
theorem isCoxeterForm_of_isClassical {Γ : MixedSignCoxeterGraph n} (hΓ : Γ.IsClassical) :
    IsCoxeterForm Γ.toReflectionSystem := by
  obtain ⟨hdiag, hoff⟩ := proposition_3_5_classical_form Γ hΓ
  refine ⟨hdiag, fun i j hij => ?_⟩
  have hb : Γ.toReflectionSystem.B i j = edgeEntry (Γ.weight i j) := hoff i j hij
  rw [hb]
  rcases hw : Γ.weight i j with _ | m
  · right; simp [edgeEntry]
  · left; exact ⟨m, Γ.weight_ge_two i j m hw, rfl⟩

/-- **Proposition 3.10** for a classical Coxeter graph `Γ`: `w(eᵢ) ∈ Φ⁺ ⇔ ℓ(w sᵢ) > ℓ(w)`. -/
theorem prop_3_10_classical {Γ : MixedSignCoxeterGraph n} (hΓ : Γ.IsClassical)
    (w : List (Fin n)) (i : Fin n) :
    IsPositive (Γ.toReflectionSystem.wordProd w *ᵥ e i) ↔
      len Γ.toReflectionSystem (Γ.toReflectionSystem.wordProd w) <
        len Γ.toReflectionSystem
          (Γ.toReflectionSystem.wordProd w * reflectionMatrix Γ.toReflectionSystem.B i) :=
  prop_3_10 (isCoxeterForm_of_isClassical hΓ) w i

/-- The matrix group of every classical Coxeter graph is a Coxeter group (the converse of
Proposition 3.5 in the sense of Theorem 3.9): it satisfies the Exchange and Deletion
Properties, and the natural map from the abstract Coxeter group is injective. -/
theorem classical_graph_isClassicalCoxeter {Γ : MixedSignCoxeterGraph n} (hΓ : Γ.IsClassical) :
    SatisfiesExchangeProperty Γ.toReflectionSystem ∧
      SatisfiesDeletionProperty Γ.toReflectionSystem ∧
      ∃ (M : CoxeterMatrix (Fin n)) (φ : M.Group →* Matrix (Fin n) (Fin n) ℝ),
        Function.Injective φ ∧
          ∀ i, φ (M.toCoxeterSystem.simple i) = reflectionMatrix Γ.toReflectionSystem.B i :=
  ⟨exchange_of_isCoxeterForm (isCoxeterForm_of_isClassical hΓ),
    deletion_of_isCoxeterForm (isCoxeterForm_of_isClassical hΓ),
    isClassicalCoxeter_of_isCoxeterForm (isCoxeterForm_of_isClassical hΓ)⟩

end RootPositivity

end MixedSignCoxeter
