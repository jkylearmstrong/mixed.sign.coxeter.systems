import MixedSignCoxeter.ClassicalDeletion

/-!
# Theorem 3.9: the Coxeter presentation from the Deletion Property

`ClassicalDeletion.lean` proves `Deletion ↔ Exchange` (`deletion_iff_exchange`). This file
proves the remaining implication of **Theorem 3.9**: a reflection system satisfying the
Deletion Property is a classical Coxeter system. Concretely, let `M = orderCoxeterMatrix S`
be the Coxeter matrix whose `(i, j)` entry is the order of `sᵢ sⱼ` (with `0` meaning `∞`).
Then the canonical homomorphism `M.Group →* Matrix (Fin n) (Fin n) ℝ` sending each Coxeter
generator to the reflection `sᵢ` is injective, so `W(S)` has the presentation
`⟨s₁, …, sₙ | sᵢ² = (sᵢ sⱼ)^{m(i,j)} = 1⟩`.

## Proof outline

Write `π w` for `S.wordProd w` (the product of reflections in `W(S)`) and `γ w` for the
product of the corresponding Coxeter generators in `M.Group`.

1. **Braid words** (`prod_altWord_eq_iff`): in any monoid generated by involutions,
   the alternating words `a b a ⋯` and `b a b ⋯` of length `k` have equal products iff
   `(a b)^k = 1`. Since `m(a, b)` is the exact order of `sₐ s_b`, equality under `π` forces
   `m(a, b) ∣ k`, hence equality under `γ` (`gamma_altWord_of_pi`).
2. **Matsumoto-type lemma** (`gamma_eq_of_reduced_of_same_length`): two reduced words
   with the same image in `W(S)` have the same image in `M.Group`. The proof is the
   classical argument of Bourbaki / Björner–Brenti by strong induction on the length `q`.
   Given reduced `u, v = s :: v'`, apply the Exchange Property to `s · u`; if the deleted
   letter is not the last one, a shorter instance of the lemma finishes the proof. In the
   remaining case, one iterates, building ever-longer alternating prefixes
   (`claim`), until the words are the two alternating words of length `q`, which are
   identified by step 1.
3. **Every relation is a consequence** (`gamma_eq_of_reduced`): for any word `w` and any
   reduced word `u` with `π w = π u` we get `γ w = γ u`, by induction on `w`, using
   the Exchange Property once more. Taking `u = []` shows that every relation of `W(S)`
   holds in `M.Group`.
4. **Injectivity** (`theorem_3_9_coxeter_presentation`).
-/

open Matrix

namespace MixedSignCoxeter

/-! ### Alternating words in a monoid generated by involutions -/

/-- The alternating word `a b a b ⋯` of length `k`, built by consing on the left. -/
def altWord {α : Type*} (a b : α) : ℕ → List α
  | 0 => []
  | k + 1 => a :: altWord b a k

@[simp] lemma altWord_zero {α : Type*} (a b : α) : altWord a b 0 = [] := rfl

@[simp] lemma altWord_succ {α : Type*} (a b : α) (k : ℕ) :
    altWord a b (k + 1) = a :: altWord b a k := rfl

@[simp] lemma length_altWord {α : Type*} (a b : α) (k : ℕ) : (altWord a b k).length = k := by
  induction k generalizing a b with
  | zero => rfl
  | succ k ih => simp [ih]

/-- Dropping the last letter of a nonempty alternating word and consing the other letter
gives the other alternating word. -/
lemma cons_dropLast_altWord {α : Type*} (a b : α) (k : ℕ) :
    b :: (altWord a b (k + 1)).dropLast = altWord b a (k + 1) := by
  induction k generalizing a b with
  | zero => rfl
  | succ k ih =>
    have hne : altWord b a (k + 1) ≠ [] := by simp
    rw [altWord_succ, List.dropLast_cons_of_ne_nil hne, ih b a]
    rfl

section MonoidWords

variable {G α : Type*} [Monoid G] (f : α → G)

lemma prod_map_mul_prod_map_reverse (hf : ∀ i, f i * f i = 1) (w : List α) :
    (w.map f).prod * (w.reverse.map f).prod = 1 := by
  induction w with
  | nil => simp
  | cons a t ih =>
    simp only [List.map_cons, List.prod_cons, List.reverse_cons, List.map_append,
      List.prod_append, List.map_nil, List.prod_nil, mul_one]
    calc f a * (t.map f).prod * ((t.reverse.map f).prod * f a)
        = f a * ((t.map f).prod * (t.reverse.map f).prod) * f a := by simp only [mul_assoc]
      _ = 1 := by rw [ih, mul_one, hf]

lemma prod_altWord (hf : ∀ i, f i * f i = 1) (a b : α) (k : ℕ) :
    ((altWord a b k).map f).prod = (f a * f b) ^ k * ((altWord b a k).map f).prod := by
  induction k generalizing a b with
  | zero => simp
  | succ k ih =>
    simp only [altWord_succ, List.map_cons, List.prod_cons]
    rw [ih b a]
    set X := ((altWord a b k).map f).prod
    have hsc : f a * (f b * f a) ^ k = (f a * f b) ^ k * f a :=
      (SemiconjBy.pow_right (show SemiconjBy (f a) (f b * f a) (f a * f b) by
        unfold SemiconjBy; simp only [mul_assoc]) k).eq
    calc f a * ((f b * f a) ^ k * X) = (f a * (f b * f a) ^ k) * X := by rw [mul_assoc]
      _ = (f a * f b) ^ k * f a * X := by rw [hsc]
      _ = (f a * f b) ^ k * (f a * f b) * (f b * X) := by
        simp only [mul_assoc, ← mul_assoc (f b) (f b), hf, one_mul]
      _ = (f a * f b) ^ (k + 1) * (f b * X) := by rw [pow_succ]

/-- In a monoid generated by involutions, the two alternating words of length `k` in `a, b`
have the same product iff `(a b)^k = 1`. -/
lemma prod_altWord_eq_iff (hf : ∀ i, f i * f i = 1) (a b : α) (k : ℕ) :
    ((altWord a b k).map f).prod = ((altWord b a k).map f).prod ↔ (f a * f b) ^ k = 1 := by
  constructor
  · intro h
    have h1 := prod_altWord f hf a b k
    rw [h] at h1
    have h2 := congrArg (· * ((altWord b a k).reverse.map f).prod) h1
    simp only [mul_assoc, prod_map_mul_prod_map_reverse f hf, mul_one] at h2
    exact h2.symm
  · intro h
    rw [prod_altWord f hf a b k, h, one_mul]

end MonoidWords

/-! ### Word lemmas for `W(S)` -/

section Words

variable {n : ℕ} (S : ReflectionSystem n)

open ReflectionSystem

private lemma wp_nil : S.wordProd [] = 1 := by simp [ReflectionSystem.wordProd]

private lemma wp_cons (a : Fin n) (w : List (Fin n)) :
    S.wordProd (a :: w) = reflectionMatrix S.B a * S.wordProd w := by
  simp [ReflectionSystem.wordProd]

private lemma wp_append (u v : List (Fin n)) :
    S.wordProd (u ++ v) = S.wordProd u * S.wordProd v := by
  simp [ReflectionSystem.wordProd]

private lemma wp_mul_reverse (w : List (Fin n)) :
    S.wordProd w * S.wordProd w.reverse = 1 :=
  prod_map_mul_prod_map_reverse _ (reflectionMatrix_mul_self S) w

private lemma wp_reverse_mul (w : List (Fin n)) :
    S.wordProd w.reverse * S.wordProd w = 1 := by
  simpa using wp_mul_reverse S w.reverse

private lemma wp_cancel_right {u v : List (Fin n)} (c : List (Fin n))
    (h : S.wordProd (u ++ c) = S.wordProd (v ++ c)) : S.wordProd u = S.wordProd v := by
  have h2 := congrArg (· * S.wordProd c.reverse) h
  simpa only [wp_append, mul_assoc, wp_mul_reverse, mul_one] using h2

private lemma wp_cancel_cons {u v : List (Fin n)} (c : Fin n)
    (h : S.wordProd (c :: u) = S.wordProd (c :: v)) : S.wordProd u = S.wordProd v := by
  have h2 := congrArg (reflectionMatrix S.B c * ·) h
  simpa only [wp_cons, ← mul_assoc, reflectionMatrix_mul_self, one_mul] using h2

private lemma wp_cons_cons (c : Fin n) (u : List (Fin n)) :
    S.wordProd (c :: c :: u) = S.wordProd u := by
  rw [wp_cons, wp_cons, ← mul_assoc, reflectionMatrix_mul_self, one_mul]

/-- Move a letter across an equation in `W(S)`. -/
private lemma wp_swap {u v : List (Fin n)} (c : Fin n)
    (h : S.wordProd (c :: u) = S.wordProd v) : S.wordProd u = S.wordProd (c :: v) := by
  rw [wp_cons, ← h, ← wp_cons, wp_cons_cons]

private lemma isReduced_append_left {u v : List (Fin n)} (h : IsReducedWord S (u ++ v)) :
    IsReducedWord S u := by
  intro u' hu' heq
  apply h (u' ++ v) (by simp only [List.length_append]; omega)
  rw [wp_append, wp_append, heq]

private lemma isReduced_append_right {u v : List (Fin n)} (h : IsReducedWord S (u ++ v)) :
    IsReducedWord S v := by
  intro v' hv' heq
  apply h (u ++ v') (by simp only [List.length_append]; omega)
  rw [wp_append, wp_append, heq]

private lemma isReduced_tail {c : Fin n} {u : List (Fin n)} (h : IsReducedWord S (c :: u)) :
    IsReducedWord S u :=
  isReduced_append_right S (u := [c]) h

private lemma isReduced_of_eq {u v : List (Fin n)} (hu : IsReducedWord S u)
    (heq : S.wordProd u = S.wordProd v) (hlen : v.length ≤ u.length) : IsReducedWord S v := by
  intro v' hv' h'
  exact hu v' (by omega) (heq.trans h')

private lemma length_le_of_reduced {u v : List (Fin n)} (hu : IsReducedWord S u)
    (heq : S.wordProd u = S.wordProd v) : u.length ≤ v.length := by
  by_contra h
  exact hu v (by omega) heq

private lemma exists_reduced (w : List (Fin n)) :
    ∃ v, IsReducedWord S v ∧ S.wordProd v = S.wordProd w := by
  classical
  have hex : ∃ k, ∃ v : List (Fin n), v.length = k ∧ S.wordProd v = S.wordProd w :=
    ⟨_, w, rfl, rfl⟩
  obtain ⟨v, hvlen, hv⟩ := Nat.find_spec hex
  refine ⟨v, ?_, hv⟩
  intro u hu heq
  exact Nat.find_min hex (by omega) ⟨u, rfl, heq.symm.trans hv⟩

/-- Split a list at position `j`. -/
private lemma exists_split {α : Type*} (V : List α) (j : ℕ) (hj : j < V.length) :
    ∃ P x R, V = P ++ x :: R ∧ P.length = j ∧ V.eraseIdx j = P ++ R := by
  refine ⟨V.take j, V[j], V.drop (j + 1), ?_, ?_, ?_⟩
  · rw [← List.drop_eq_getElem_cons hj, List.take_append_drop]
  · simp only [List.length_take]; omega
  · exact List.eraseIdx_eq_take_drop_succ V j

/-- If `π (c :: P ++ x :: R) = π (P ++ R)` then `π (P ++ [x]) = π (c :: P)`. -/
private lemma wp_shift {P R : List (Fin n)} {c x : Fin n}
    (h : S.wordProd (c :: (P ++ x :: R)) = S.wordProd (P ++ R)) :
    S.wordProd (P ++ [x]) = S.wordProd (c :: P) := by
  have h1 : S.wordProd ((c :: P ++ [x]) ++ R) = S.wordProd (P ++ R) := by
    simpa using h
  have h2 := wp_cancel_right S R h1
  rw [List.cons_append, wp_cons, wp_append] at h2
  rw [wp_append, wp_cons, ← h2, wp_cons, wp_nil, mul_one]
  simp only [mul_assoc, reflectionMatrix_mul_self, mul_one, wp_cons]

end Words

/-! ### Word lemmas in the Coxeter group `M.Group` -/

section CoxeterWords

variable {n : ℕ} (M : CoxeterMatrix (Fin n))

private lemma gamma_swap {u v : List (Fin n)} (c : Fin n)
    (h : M.toCoxeterSystem.wordProd (c :: u) = M.toCoxeterSystem.wordProd v) :
    M.toCoxeterSystem.wordProd u = M.toCoxeterSystem.wordProd (c :: v) := by
  rw [M.toCoxeterSystem.wordProd_cons, ← h, M.toCoxeterSystem.wordProd_cons,
    M.toCoxeterSystem.simple_mul_simple_cancel_left]

private lemma gamma_shift {P R : List (Fin n)} {c x : Fin n}
    (h : M.toCoxeterSystem.wordProd (P ++ [x]) = M.toCoxeterSystem.wordProd (c :: P)) :
    M.toCoxeterSystem.wordProd (c :: (P ++ x :: R)) = M.toCoxeterSystem.wordProd (P ++ R) := by
  have : c :: (P ++ x :: R) = (c :: P) ++ [x] ++ R := by simp
  rw [this, M.toCoxeterSystem.wordProd_append, M.toCoxeterSystem.wordProd_append, ← h,
    M.toCoxeterSystem.wordProd_append, M.toCoxeterSystem.wordProd_append]
  simp only [CoxeterSystem.wordProd, List.map_cons, List.map_nil, List.prod_cons,
    List.prod_nil, mul_one, mul_assoc, M.toCoxeterSystem.simple_mul_simple_cancel_left]

end CoxeterWords

/-! ### The Matsumoto-type lemma and the main theorem -/

section Presentation

variable {n : ℕ} (S : ReflectionSystem n) (M : CoxeterMatrix (Fin n))

open ReflectionSystem

/-- If `m(a, b)` is the exact order of `sₐ s_b` in `W(S)`, then any braid relation between
alternating words that holds in `W(S)` also holds in `M.Group`. -/
theorem gamma_altWord_of_pi
    (hM : ∀ i j, orderOf (reflectionMatrix S.B i * reflectionMatrix S.B j) = M i j)
    (a b : Fin n) (k : ℕ) (h : S.wordProd (altWord a b k) = S.wordProd (altWord b a k)) :
    M.toCoxeterSystem.wordProd (altWord a b k) = M.toCoxeterSystem.wordProd (altWord b a k) := by
  have h1 := (prod_altWord_eq_iff (reflectionMatrix S.B) (reflectionMatrix_mul_self S)
    a b k).1 h
  have hdvd : M a b ∣ k := hM a b ▸ orderOf_dvd_of_pow_eq_one h1
  obtain ⟨c, rfl⟩ := hdvd
  exact (prod_altWord_eq_iff M.toCoxeterSystem.simple
    M.toCoxeterSystem.simple_mul_simple_self a b _).2
    (by rw [pow_mul, M.toCoxeterSystem.simple_mul_simple_pow, one_pow])

variable {S M}

/-- **Matsumoto-type lemma**: if `S` has the Exchange Property and every braid relation of
`W(S)` holds in `M.Group`, then two reduced words of the same length with the same image in
`W(S)` have the same image in `M.Group`. -/
theorem gamma_eq_of_reduced_of_same_length (hex : SatisfiesExchangeProperty S)
    (hbraid : ∀ a b k, S.wordProd (altWord a b k) = S.wordProd (altWord b a k) →
      M.toCoxeterSystem.wordProd (altWord a b k) = M.toCoxeterSystem.wordProd (altWord b a k)) :
    ∀ (q : ℕ) (u v : List (Fin n)), u.length = q → v.length = q → IsReducedWord S u →
      S.wordProd u = S.wordProd v → M.toCoxeterSystem.wordProd u = M.toCoxeterSystem.wordProd v := by
  intro q
  induction q using Nat.strong_induction_on with
  | _ q ihq =>
  -- Exchanging a letter that is not the last one reduces to a shorter instance.
  have shift : ∀ (V : List (Fin n)) (c : Fin n) (j : ℕ), V.length = q → IsReducedWord S V →
      j + 1 < q → S.wordProd (c :: V) = S.wordProd (V.eraseIdx j) →
      M.toCoxeterSystem.wordProd (c :: V) = M.toCoxeterSystem.wordProd (V.eraseIdx j) := by
    intro V c j hV hred hj h
    obtain ⟨P, x, R, rfl, hP, herase⟩ := exists_split V j (by omega)
    rw [herase] at h ⊢
    apply gamma_shift
    have hred' : IsReducedWord S (P ++ [x]) :=
      isReduced_append_left S (v := R) (by simpa using hred)
    exact ihq (j + 1) (by omega) (P ++ [x]) (c :: P) (by simp [hP]) (by simp [hP]) hred'
      (wp_shift S h)
  -- The iteration that builds longer and longer alternating prefixes.
  have claim : ∀ (m : ℕ) (a b : Fin n) (k : ℕ) (z : List (Fin n)), z.length = m →
      k + m = q → 1 ≤ k → IsReducedWord S (altWord a b k ++ z) →
      S.wordProd (altWord a b k ++ z) = S.wordProd (b :: (altWord a b k ++ z).dropLast) →
      M.toCoxeterSystem.wordProd (altWord a b k ++ z) =
        M.toCoxeterSystem.wordProd (b :: (altWord a b k ++ z).dropLast) := by
    intro m
    induction m with
    | zero =>
      intro a b k z hz hkq hk _ h
      obtain rfl : z = [] := List.eq_nil_of_length_eq_zero hz
      obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      simp only [List.append_nil, cons_dropLast_altWord] at h ⊢
      exact hbraid a b _ h
    | succ m ihm =>
      intro a b k z hz hkq hk hred h
      obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      have hzne : z ≠ [] := by rintro rfl; simp at hz
      set U := altWord a b (k' + 1) ++ z with hU
      set T := altWord b a k' ++ z with hT
      have hUT : U = a :: T := rfl
      have hUlen : U.length = q := by simp [hU, hz]; omega
      set V := b :: U.dropLast with hV
      have hVlen : V.length = q := by simp [hV, hUlen]; omega
      have hVred : IsReducedWord S V := isReduced_of_eq S hred h (by omega)
      have hTred : IsReducedWord S T := isReduced_tail S (hUT ▸ hred)
      have haV : S.wordProd (a :: V) = S.wordProd T := by
        rw [wp_cons, ← h, hUT, ← wp_cons, wp_cons_cons]
      obtain ⟨j, hj, hjeq⟩ := hex a V hVred ⟨T, by simp [hT, hVlen, hz]; omega, haV⟩
      have hTlen : T.length = q - 1 := by simp [hT, hz]; omega
      by_cases hjq : j + 1 < q
      · -- the exchanged letter is not the last one
        have h1 := shift V a j hVlen hVred hjq hjeq
        have h2 : M.toCoxeterSystem.wordProd T =
            M.toCoxeterSystem.wordProd (V.eraseIdx j) :=
          ihq (q - 1) (by omega) T _ hTlen (by rw [List.length_eraseIdx_of_lt hj]; omega)
            hTred (haV.symm.trans hjeq)
        rw [hUT, M.toCoxeterSystem.wordProd_cons, h2, ← M.toCoxeterSystem.wordProd_cons]
        exact (gamma_swap M a h1).symm
      · -- the exchanged letter is the last one: iterate
        rw [← List.dropLast_eq_eraseIdx (by omega : j + 1 = V.length)] at hjeq
        have hVdrop : V = altWord b a (k' + 2) ++ z.dropLast := by
          rw [hV, hU, List.dropLast_append_of_ne_nil hzne]; rfl
        have hnext := ihm b a (k' + 2) z.dropLast (by simp [hz]) (by omega) (by omega)
          (hVdrop ▸ hVred) (hVdrop ▸ wp_swap S a hjeq)
        rw [← hVdrop] at hnext
        have h2 : M.toCoxeterSystem.wordProd T = M.toCoxeterSystem.wordProd V.dropLast :=
          ihq (q - 1) (by omega) T _ hTlen (by simp only [List.length_dropLast, hVlen]) hTred
            (haV.symm.trans hjeq)
        rw [hnext, hUT, M.toCoxeterSystem.wordProd_cons, h2, ← M.toCoxeterSystem.wordProd_cons]
  -- The main step.
  intro u v hu hv hred heq
  rcases v with _ | ⟨s, v'⟩
  · simp at hv; subst hv
    rw [List.eq_nil_of_length_eq_zero hu]
  · have hvred : IsReducedWord S (s :: v') := isReduced_of_eq S hred heq (by omega)
    have hv'red : IsReducedWord S v' := isReduced_tail S hvred
    have hsu : S.wordProd (s :: u) = S.wordProd v' := by rw [wp_cons, heq, ← wp_cons, wp_cons_cons]
    obtain ⟨j, hj, hjeq⟩ := hex s u hred ⟨v', by simp at hv ⊢; omega, hsu⟩
    have hv'len : v'.length = q - 1 := by simp at hv; omega
    have h2 : M.toCoxeterSystem.wordProd v' = M.toCoxeterSystem.wordProd (u.eraseIdx j) :=
      ihq (q - 1) (by omega) v' _ hv'len (by rw [List.length_eraseIdx_of_lt hj]; omega)
        hv'red (hsu.symm.trans hjeq)
    by_cases hjq : j + 1 < q
    · have h1 := shift u s j hu hred hjq hjeq
      rw [M.toCoxeterSystem.wordProd_cons, h2]
      exact gamma_swap M s h1
    · rw [← List.dropLast_eq_eraseIdx (by omega : j + 1 = u.length)] at hjeq h2
      rcases u with _ | ⟨t, u'⟩
      · simp at hj
      · have hc := claim (q - 1) t s 1 u' (by simp at hu; omega) (by simp at hu; omega) le_rfl
          (by simpa using hred) (by simpa using wp_swap S s hjeq)
        simp only [altWord_succ, altWord_zero, List.singleton_append] at hc
        rw [hc, M.toCoxeterSystem.wordProd_cons s v', h2, M.toCoxeterSystem.wordProd_cons]

/-- **Every relation of `W(S)` holds in `M.Group`**: under the Exchange Property and the
braid hypothesis, any word with the same image in `W(S)` as a reduced word `u` has the
same image in `M.Group` as `u`. -/
theorem gamma_eq_of_reduced (hex : SatisfiesExchangeProperty S)
    (hbraid : ∀ a b k, S.wordProd (altWord a b k) = S.wordProd (altWord b a k) →
      M.toCoxeterSystem.wordProd (altWord a b k) = M.toCoxeterSystem.wordProd (altWord b a k)) :
    ∀ (w u : List (Fin n)), IsReducedWord S u → S.wordProd w = S.wordProd u →
      M.toCoxeterSystem.wordProd w = M.toCoxeterSystem.wordProd u := by
  have hML := gamma_eq_of_reduced_of_same_length hex hbraid
  have hsame : ∀ u v : List (Fin n), IsReducedWord S u → IsReducedWord S v →
      S.wordProd u = S.wordProd v →
      M.toCoxeterSystem.wordProd u = M.toCoxeterSystem.wordProd v := by
    intro u v hu hv h
    have h1 := length_le_of_reduced S hu h
    have h2 := length_le_of_reduced S hv h.symm
    exact hML u.length u v rfl (by omega) hu h
  intro w
  induction w with
  | nil =>
    intro u hu h
    have hlen := length_le_of_reduced S hu h.symm
    simp only [List.length_nil, Nat.le_zero, List.length_eq_zero_iff] at hlen
    rw [hlen]
  | cons s t ih =>
    intro u hu h
    obtain ⟨v, hvred, hv⟩ := exists_reduced S t
    have hγt := ih v hvred hv.symm
    have hsv : S.wordProd (s :: v) = S.wordProd (s :: t) := by rw [wp_cons, wp_cons, hv]
    rw [M.toCoxeterSystem.wordProd_cons, hγt, ← M.toCoxeterSystem.wordProd_cons]
    by_cases hr : IsReducedWord S (s :: v)
    · exact hsame _ _ hr hu (hsv.trans h)
    · have hr' := hr
      unfold IsReducedWord at hr'
      push Not at hr'
      obtain ⟨k, hk, hkeq⟩ := hex s v hvred hr'
      -- the word `v` with letter `k` deleted is reduced
      have hered : IsReducedWord S (v.eraseIdx k) := by
        intro y hy hyeq
        apply hvred (s :: y) (by rw [List.length_eraseIdx_of_lt hk] at hy; simp; omega)
        rw [← wp_cons_cons S s v, wp_cons S s (s :: v), hkeq, hyeq, ← wp_cons]
      obtain ⟨P, x, R, hPR, hP, herase⟩ := exists_split v k hk
      have hγ : M.toCoxeterSystem.wordProd (s :: v) =
          M.toCoxeterSystem.wordProd (v.eraseIdx k) := by
        rw [herase, hPR]
        apply gamma_shift
        rw [herase, hPR] at hkeq
        rw [hPR] at hvred
        exact hsame _ _ (isReduced_append_left S (v := R) (by simpa using hvred))
          (isReduced_of_eq S (isReduced_append_left S (v := R) (by simpa using hvred))
            (wp_shift S hkeq) (by simp))
          (wp_shift S hkeq)
      rw [hγ]
      exact hsame _ _ hered hu (hkeq.symm.trans (hsv.trans h))

/-! ### Theorem 3.9: Deletion ⇒ classical Coxeter system -/

variable (S)

private lemma reflectionMatrix_ne {i j : Fin n} (hij : i ≠ j) :
    reflectionMatrix S.B i ≠ reflectionMatrix S.B j := by
  intro h
  have h1 := congrFun (congrFun h i) i
  rw [reflectionMatrix_apply_self S.B (S.B_diag_ne_zero i)] at h1
  simp [hij] at h1
  norm_num at h1

private lemma pow_mul_comm_eq_one {G : Type*} [Monoid G] {x y : G}
    (hy : y * y = 1) (k : ℕ) (h : (x * y) ^ k = 1) : (y * x) ^ k = 1 := by
  have hsc : y * (x * y) ^ k = (y * x) ^ k * y :=
    (SemiconjBy.pow_right (show SemiconjBy y (x * y) (y * x) by
      unfold SemiconjBy; simp only [mul_assoc]) k).eq
  rw [h, mul_one] at hsc
  calc (y * x) ^ k = (y * x) ^ k * y * y := by rw [mul_assoc, hy, mul_one]
    _ = 1 := by rw [← hsc, hy]

/-- The **order Coxeter matrix** of `S`: its `(i, j)` entry is the order of `sᵢ sⱼ`
in `W(S)`, with `0` standing for `∞` (Lemma 3.17 computes these orders for
mixed-sign systems). -/
noncomputable def orderCoxeterMatrix : CoxeterMatrix (Fin n) where
  M := Matrix.of fun i j => orderOf (reflectionMatrix S.B i * reflectionMatrix S.B j)
  isSymm := by
    ext i j
    simp only [Matrix.transpose_apply, Matrix.of_apply]
    exact orderOf_eq_orderOf_iff.2 fun k =>
      ⟨pow_mul_comm_eq_one (reflectionMatrix_mul_self S i) k,
        pow_mul_comm_eq_one (reflectionMatrix_mul_self S j) k⟩
  diagonal := by
    intro i
    simp [reflectionMatrix_mul_self S i]
  off_diagonal := by
    intro i j hij
    simp only [Matrix.of_apply, ne_eq, orderOf_eq_one_iff]
    intro h
    apply reflectionMatrix_ne S hij
    calc reflectionMatrix S.B i
        = reflectionMatrix S.B i * reflectionMatrix S.B j * reflectionMatrix S.B j := by
          rw [mul_assoc, reflectionMatrix_mul_self, mul_one]
      _ = reflectionMatrix S.B j := by rw [h, one_mul]

@[simp] lemma orderCoxeterMatrix_apply (i j : Fin n) :
    orderCoxeterMatrix S i j = orderOf (reflectionMatrix S.B i * reflectionMatrix S.B j) := rfl

lemma orderCoxeterMatrix_isLiftable :
    (orderCoxeterMatrix S).IsLiftable (reflectionMatrix S.B) := by
  intro i j
  rw [orderCoxeterMatrix_apply]
  exact pow_orderOf_eq_one _

/-- The canonical homomorphism from the Coxeter group of the order matrix onto `W(S)`,
sending the `i`-th Coxeter generator to the reflection `sᵢ`. -/
noncomputable def orderCoxeterLift :
    (orderCoxeterMatrix S).Group →* Matrix (Fin n) (Fin n) ℝ :=
  (orderCoxeterMatrix S).toCoxeterSystem.lift
    ⟨reflectionMatrix S.B, orderCoxeterMatrix_isLiftable S⟩

lemma orderCoxeterLift_simple (i : Fin n) :
    orderCoxeterLift S ((orderCoxeterMatrix S).toCoxeterSystem.simple i) =
      reflectionMatrix S.B i :=
  (orderCoxeterMatrix S).toCoxeterSystem.lift_apply_simple (orderCoxeterMatrix_isLiftable S) i

lemma orderCoxeterLift_wordProd (w : List (Fin n)) :
    orderCoxeterLift S ((orderCoxeterMatrix S).toCoxeterSystem.wordProd w) = S.wordProd w := by
  induction w with
  | nil => simp [CoxeterSystem.wordProd, ReflectionSystem.wordProd]
  | cons a t ih =>
    rw [CoxeterSystem.wordProd_cons, map_mul, ih, orderCoxeterLift_simple, wp_cons]

/-- **Theorem 3.9 (relations)**: if `S` satisfies the Deletion Property, every relation
among the generating reflections of `W(S)` is a consequence of the Coxeter relations
`sᵢ² = (sᵢ sⱼ)^{m(i,j)} = 1`, where `m(i, j)` is the order of `sᵢ sⱼ`. -/
theorem coxeter_wordProd_eq_one_of_deletion (hdel : SatisfiesDeletionProperty S)
    (w : List (Fin n)) (h : S.wordProd w = 1) :
    (orderCoxeterMatrix S).toCoxeterSystem.wordProd w = 1 := by
  have hex := exchange_of_deletion S hdel
  have hbraid := gamma_altWord_of_pi S (orderCoxeterMatrix S) (fun i j => rfl)
  have hnil : IsReducedWord S [] := fun u hu => absurd hu (by simp)
  have := gamma_eq_of_reduced hex hbraid w [] hnil (by rw [h, wp_nil])
  simpa [CoxeterSystem.wordProd] using this

/-- **Theorem 3.9 (Deletion ⇒ classical Coxeter system)**: if a reflection system `S`
satisfies the Deletion Property, then the canonical map from the Coxeter group of its order
matrix onto `W(S)` is injective. Hence `W(S)` has the Coxeter presentation
`⟨s₁, …, sₙ | sᵢ² = (sᵢ sⱼ)^{m(i,j)} = 1⟩` and `(W, S, B)` is a classical Coxeter system. -/
theorem theorem_3_9_coxeter_presentation (hdel : SatisfiesDeletionProperty S) :
    Function.Injective (orderCoxeterLift S) := by
  set cs := (orderCoxeterMatrix S).toCoxeterSystem
  intro x y hxy
  obtain ⟨w, hw⟩ := cs.wordProd_surjective (x⁻¹ * y)
  have h1 : S.wordProd w = 1 := by
    rw [← orderCoxeterLift_wordProd, hw, map_mul, ← hxy, ← map_mul, inv_mul_cancel, map_one]
  have h2 := coxeter_wordProd_eq_one_of_deletion S hdel w h1
  rw [hw] at h2
  exact inv_mul_eq_one.1 h2

/-- **Theorem 3.9 (Exchange ⇒ classical Coxeter system)**. -/
theorem theorem_3_9_coxeter_presentation_of_exchange (hex : SatisfiesExchangeProperty S) :
    Function.Injective (orderCoxeterLift S) :=
  theorem_3_9_coxeter_presentation S ((deletion_iff_exchange S).2 hex)

/-- **Theorem 3.9 (packaged)**: a reflection system with the Deletion Property is a classical
Coxeter system: there is a Coxeter matrix `M` and an injective homomorphism
`M.Group →* Matrix (Fin n) (Fin n) ℝ` sending each Coxeter generator to the corresponding
reflection `sᵢ`. -/
theorem theorem_3_9_isClassicalCoxeter (hdel : SatisfiesDeletionProperty S) :
    ∃ (M : CoxeterMatrix (Fin n)) (φ : M.Group →* Matrix (Fin n) (Fin n) ℝ),
      Function.Injective φ ∧ ∀ i, φ (M.toCoxeterSystem.simple i) = reflectionMatrix S.B i :=
  ⟨orderCoxeterMatrix S, orderCoxeterLift S, theorem_3_9_coxeter_presentation S hdel,
    orderCoxeterLift_simple S⟩

end Presentation

end MixedSignCoxeter
